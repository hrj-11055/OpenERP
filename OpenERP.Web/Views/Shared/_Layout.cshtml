                        <i class="bi bi-gear"></i>
                        <span>我的设定</span>
                    </button>
                    <button type="button" class="layout-shell__sidebar-user-menu-item">
                        <i class="bi bi-lock-fill"></i>
                        <span>修改密码</span>
                    </button>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="layout-shell__sidebar-user-menu-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="layout-shell__sidebar-user-menu-item layout-shell__sidebar-user-menu-item--logout">
