    var canViewReportHr = HasPermission("REPORT_CENTER", "REPORT_HR");
    // 财务报表权限（用于显示报表中心下的财务报表菜单）。
    var canViewReportFinance = HasPermission("REPORT_CENTER", "REPORT_FINANCE");
    // 采购报表权限（用于显示报表中心下的采购报表菜单）。
    var canViewReportPurchasing = HasPermission("REPORT_CENTER", "REPORT_PURCHASING");
    // 销售报表权限（用于显示报表中心下的销售报表菜单）。
    var canViewReportSales = HasPermission("REPORT_CENTER", "REPORT_SALES");
    // 仓务报表权限（用于显示报表中心下的仓务报表菜单）。
    var canViewReportWarehouse = HasPermission("REPORT_CENTER", "REPORT_WAREHOUSE");
    // 生产报表权限（用于显示报表中心下的生产报表菜单）。
    var canViewReportProduction = HasPermission("REPORT_CENTER", "REPORT_PRODUCTION");
    // 服务报表权限（用于显示报表中心下的服务报表菜单）。
    var canViewReportService = HasPermission("REPORT_CENTER", "REPORT_SERVICE");
    // 考勤报表权限（用于显示报表中心下的考勤报表菜单）。
    var canViewReportAttendance = HasPermission("REPORT_CENTER", "REPORT_ATTENDANCE");
    // 资产报表权限（用于显示报表中心下的资产报表菜单）。
    var canViewReportAsset = HasPermission("REPORT_CENTER", "REPORT_ASSET");
    // 办公报表权限（用于显示报表中心下的办公报表菜单）。
    var canViewReportOffice = HasPermission("REPORT_CENTER", "REPORT_OFFICE");
    // 运输报表权限（用于显示报表中心下的运输报表菜单）。
    var canViewReportTransport = HasPermission("REPORT_CENTER", "REPORT_TRANSPORT");
    // CRM（客户关系管理）报表权限（用于显示报表中心下的CRM报表菜单）。
    var canViewReportCrm = HasPermission("REPORT_CENTER", "REPORT_CRM");
    // 报表中心父级菜单权限（用于承载各模块报表子功能）。
    var canViewReportCenter = canViewReportHr
        || canViewReportFinance
        || canViewReportPurchasing
        || canViewReportSales
        || canViewReportWarehouse
        || canViewReportProduction
        || canViewReportService
        || canViewReportAttendance
        || canViewReportAsset
        || canViewReportOffice
        || canViewReportTransport
        || canViewReportCrm;
    // 报表中心菜单展开状态（进入报表中心区域时自动展开子功能）。
    var isReportCenterMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "ReportCenter", StringComparison.OrdinalIgnoreCase);
    // 基础资料权限（用于显示基本资料下的基础资料菜单，复用基础数据维护模块）。
    var canViewBasicData = HasPermission("BASIC_DATA", "BASIC_DATA_TYPES", "BASIC_DATA_ITEMS");
    // 客户/友商资料权限（用于显示基本资料下的客户与友商资料菜单）。
    var canViewBasicInformationCustomers = HasPermission("BASIC_INFORMATION", "BASIC_INFO_CUSTOMERS");
    // 供应商/厂商资料权限（用于显示基本资料下的供应商与厂商资料菜单）。
    var canViewBasicInformationSuppliers = HasPermission("BASIC_INFORMATION", "BASIC_INFO_SUPPLIERS");
    // 仓库/车间资料权限（用于显示基本资料下的仓库与车间资料菜单）。
    var canViewBasicInformationWarehouses = HasPermission("BASIC_INFORMATION", "BASIC_INFO_WAREHOUSES");
    // 工程项目资料权限（用于显示基本资料下的工程项目资料菜单）。
    var canViewBasicInformationProjects = HasPermission("BASIC_INFORMATION", "BASIC_INFO_PROJECTS");
    // 基本资料父级菜单权限（用于承载客户、供应商、仓库车间和工程项目资料子功能）。
    var canViewBasicInformation = canViewBasicInformationCustomers
        || canViewBasicInformationSuppliers
        || canViewBasicInformationWarehouses
        || canViewBasicInformationProjects
        || canViewBasicData;
    // 基本资料菜单展开状态（进入基本资料或基础资料区域时自动展开子功能）。
    var isBasicInformationMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "BasicInformation", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Context.Request.RouteValues["area"]?.ToString(), "BasicData", StringComparison.OrdinalIgnoreCase);
    // 我的审批权限（用于显示任务中心下的我的审批菜单）。
    var canViewTaskMyApprovals = HasPermission("TASK_CENTER", "TASK_MY_APPROVALS");
    // 日常任务权限（用于显示任务中心下的日常任务菜单）。
    var canViewTaskDailyTasks = HasPermission("TASK_CENTER", "TASK_DAILY_TASKS");
    // 跟单管理权限（用于显示任务中心下的跟单管理菜单）。
    var canViewTaskFollowUps = HasPermission("TASK_CENTER", "TASK_FOLLOW_UPS");
    // 内容消息权限（用于显示任务中心下的内容消息菜单）。
    var canViewTaskContentMessages = HasPermission("TASK_CENTER", "TASK_CONTENT_MESSAGES");
    // 收发邮件权限（用于显示任务中心下的收发邮件菜单）。
    var canViewTaskEmails = HasPermission("TASK_CENTER", "TASK_EMAILS");
    // 系统公告权限（用于显示任务中心下的系统公告菜单）。
    var canViewTaskAnnouncements = HasPermission("TASK_CENTER", "TASK_ANNOUNCEMENTS");
    // 任务中心父级菜单权限（用于承载审批、任务、跟单、消息、邮件和公告子功能）。
    var canViewTaskCenter = canViewTaskMyApprovals
        || canViewTaskDailyTasks
        || canViewTaskFollowUps
        || canViewTaskContentMessages
        || canViewTaskEmails
        || canViewTaskAnnouncements;
    // 任务中心菜单展开状态（进入任务中心区域时自动展开子功能）。
    var isTaskCenterMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "TaskCenter", StringComparison.OrdinalIgnoreCase);
    // RFID Reader（射频识别读写器）权限（用于显示系统设备下的RFID Reader菜单）。
    var canViewSystemDeviceRfidReaders = HasPermission("SYSTEM_DEVICES", "SYSTEM_DEVICE_RFID_READERS");
    // 镜头设备权限（用于显示系统设备下的镜头设备菜单）。
    var canViewSystemDeviceCameras = HasPermission("SYSTEM_DEVICES", "SYSTEM_DEVICE_CAMERAS");
    // GPIO（通用输入输出接口）设备权限（用于显示系统设备下的GPIO设备菜单）。
    var canViewSystemDeviceGpioDevices = HasPermission("SYSTEM_DEVICES", "SYSTEM_DEVICE_GPIO_DEVICES");
    // 系统设备父级菜单权限（用于承载RFID Reader、镜头设备和GPIO设备子功能）。
    var canViewSystemDevices = canViewSystemDeviceRfidReaders
        || canViewSystemDeviceCameras
        || canViewSystemDeviceGpioDevices;
    // 系统设备菜单展开状态（进入系统设备区域时自动展开子功能）。
    var isSystemDeviceMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "SystemDevice", StringComparison.OrdinalIgnoreCase);
    // 在线帮助权限（用于显示技术支持下的在线帮助菜单）。
    var canViewTechnicalSupportOnlineHelp = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_ONLINE_HELP");
    // 下载中心权限（用于显示技术支持下的下载中心菜单）。
    var canViewTechnicalSupportDownloadCenter = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_DOWNLOAD_CENTER");
    // 在线支持权限（用于显示技术支持下的在线支持菜单）。
    var canViewTechnicalSupportOnlineSupport = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_ONLINE_SUPPORT");
    // 联络我们权限（用于显示技术支持下的联络我们菜单）。
    var canViewTechnicalSupportContactUs = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_CONTACT_US");
    // 系统版本权限（用于显示技术支持下的系统版本菜单）。
    var canViewTechnicalSupportSystemVersion = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_SYSTEM_VERSION");
    // 在线更新权限（用于显示技术支持下的在线更新菜单）。
    var canViewTechnicalSupportOnlineUpdates = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_ONLINE_UPDATES");
    // 更新日志权限（用于显示技术支持下的更新日志菜单）。
    var canViewTechnicalSupportUpdateLogs = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_UPDATE_LOGS");
    // API（应用程序接口）管理权限（用于显示技术支持下的API管理菜单）。
    var canViewTechnicalSupportApiManagement = HasPermission("TECHNICAL_SUPPORT", "TECH_SUPPORT_API_MANAGEMENT");
    // 技术支持父级菜单权限（用于承载帮助、下载、在线支持、版本、更新和API管理子功能）。
    var canViewTechnicalSupport = canViewTechnicalSupportOnlineHelp
        || canViewTechnicalSupportDownloadCenter
        || canViewTechnicalSupportOnlineSupport
        || canViewTechnicalSupportContactUs
        || canViewTechnicalSupportSystemVersion
        || canViewTechnicalSupportOnlineUpdates
        || canViewTechnicalSupportUpdateLogs
        || canViewTechnicalSupportApiManagement;
    // 技术支持菜单展开状态（进入技术支持区域时自动展开子功能）。
    var isTechnicalSupportMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "TechnicalSupport", StringComparison.OrdinalIgnoreCase);
    // 用户资料权限（用于显示系统管理下的用户资料菜单）。
    var canViewSystemManagementUsers = HasPermission("SYSTEM_SETTINGS", "SYSTEM_USERS");
    // 角色管理权限（用于显示系统管理下的角色管理菜单）。
    var canViewSystemManagementRoles = HasPermission("SYSTEM_SETTINGS", "SYSTEM_ROLES");
    // 系统设置权限（用于显示系统管理下的系统设置菜单）。
    var canViewSystemManagementSettings = HasPermission("SYSTEM_SETTINGS", "SYSTEM_CONFIGURATIONS");
    // 在线用户权限（用于显示系统管理下的在线用户菜单）。
    var canViewSystemManagementOnlineUsers = HasPermission("SYSTEM_SETTINGS", "SYSTEM_ONLINE_USERS");
    // 登入日志权限（用于显示系统管理下查看日志中的登入日志菜单）。
    var canViewSystemLoginLogs = HasPermission("SYSTEM_SETTINGS", "SYSTEM_LOGS", "SYSTEM_LOGIN_LOGS");
    // 操作日志权限（用于显示系统管理下查看日志中的操作日志菜单）。
    var canViewSystemOperationLogs = HasPermission("SYSTEM_SETTINGS", "SYSTEM_LOGS", "SYSTEM_OPERATION_LOGS");
    // 系统日志权限（用于显示系统管理下查看日志中的系统日志菜单）。
    var canViewSystemSystemLogs = HasPermission("SYSTEM_SETTINGS", "SYSTEM_LOGS", "SYSTEM_SYSTEM_LOGS");
    // 查看日志权限（用于承载登入日志、操作日志和系统日志子功能）。
    var canViewSystemManagementLogs = canViewSystemLoginLogs
        || canViewSystemOperationLogs
        || canViewSystemSystemLogs;
    // 系统管理父级菜单权限（用于承载用户、角色、设置、在线用户和日志子功能）。
    var canViewSystemManagement = canViewSystemManagementUsers
        || canViewSystemManagementRoles
        || canViewSystemManagementSettings
        || canViewSystemManagementOnlineUsers
        || canViewSystemManagementLogs;
    // 系统管理菜单展开状态（进入系统管理区域时自动展开子功能）。
    var isSystemManagementMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "SystemManagement", StringComparison.OrdinalIgnoreCase);
    var currentSystemManagementAction = Context.Request.RouteValues["action"]?.ToString();
    // 查看日志菜单展开状态（进入任一日志页面时自动展开日志子功能）。
    var isSystemManagementLogsMenuOpen = isSystemManagementMenuOpen
        && new[] { "Logs", "LoginLogs", "OperationLogs", "SystemLogs" }
            .Contains(currentSystemManagementAction, StringComparer.OrdinalIgnoreCase);
    var companyOrganizations = await HrRepository.GetCompanyOrganizationsAsync();
    var companyOptions = companyOrganizations
        .Where(organization => !string.IsNullOrWhiteSpace(organization.OrganizationCode))
        .Where(organization => !shouldRestrictCompanyOptions || allowedCompanyCodes.Contains(organization.OrganizationCode))
        .OrderBy(organization => organization.OrganizationCode)
        .Select(organization => new
        {
            Value = organization.OrganizationCode,
            Code = organization.OrganizationCode,
            Text = organization.OrganizationName
        })
        .ToArray();
    if (companyOptions.Length == 0)
    {
        companyOptions =
        [
            new
            {
                Value = currentCompanyValue,
                Code = currentCompanyValue,
                Text = currentCompanyValue
            }
        ];
    }
    var currentCompany = companyOptions.FirstOrDefault(option => string.Equals(option.Value, currentCompanyValue, StringComparison.OrdinalIgnoreCase))
        ?? companyOptions.FirstOrDefault()
        ?? new { Value = currentCompanyValue, Code = currentCompanyValue, Text = currentCompanyValue };
    var currentCompanyPrintSettings = await CompanyPrintTemplateService.GetSettingsByOrganizationCodeAsync(currentCompany.Value);
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"] - @Localizer["AppName"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpenERP.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("_CompanyPrintChrome", currentCompanyPrintSettings)
    <div class="layout-shell">
        <div class="bg-dark border-right text-white layout-shell__sidebar" id="sidebar-wrapper">
            <div class="sidebar-heading p-4">
                <h3 class="m-0 text-white">@Localizer["AppName"]</h3>
            </div>
            <div class="list-group list-group-flush layout-shell__sidebar-nav">
                @if (canViewDashboard)
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0">
                        <i class="bi bi-speedometer2 me-2"></i> @Localizer["Common_Dashboard"]
                    </a>
                }
                @if (canViewPurchasing)
                {
                    <a class="list-group-item list-group-item-action bg-dark text-white border-0 d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse" href="#purchasingMenu" role="button" aria-expanded="@(isPurchasingMenuOpen ? "true" : "false")" aria-controls="purchasingMenu">
                        <span><i class="bi bi-bag-check me-2"></i> @Localizer["Layout_Purchasing"]</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                    <div class="collapse @(isPurchasingMenuOpen ? "show" : string.Empty)" id="purchasingMenu">
                        @if (canViewPurchasingSuppliers)
                        {
                            <a asp-area="Purchasing" asp-controller="Suppliers" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-building-check me-2"></i> 供应商/厂商资料
                            </a>
                        }
                        @if (canViewPurchasingContracts)
                        {
                            <a asp-area="Purchasing" asp-controller="SupplyChain" asp-action="Contracts" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-file-earmark-text me-2"></i> 合约管理
                            </a>
                        }
                        @if (canViewPurchasingInquiries)
                        {
                            <a asp-area="Purchasing" asp-controller="SupplyChain" asp-action="Inquiries" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-search me-2"></i> 采购询价
                            </a>
                        }
                        @if (canViewPurchasingPurchaseOrders)
                        {
                            <a asp-area="Purchasing" asp-controller="PurchaseOrders" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-receipt-cutoff me-2"></i> 采购订单
                            </a>
                        }
                        @if (canViewPurchasingInvoices)
                        {
                            <a asp-area="Purchasing" asp-controller="SupplyChain" asp-action="Invoices" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-journal-text me-2"></i> 采购发票
                            </a>
                        }
                        @if (canViewPurchasingPayments)
                        {
                            <a asp-area="Purchasing" asp-controller="SupplyChain" asp-action="Payments" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-cash-coin me-2"></i> 采购付款
                            </a>
                        }
                        @if (canViewPurchasingPrepayments)
                        {
                            <a asp-area="Purchasing" asp-controller="SupplyChain" asp-action="Prepayments" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-wallet2 me-2"></i> 预付款
                            </a>
                        }
                        @if (canViewPurchasingReturns)
                        {
                            <a asp-area="Purchasing" asp-controller="SupplyChain" asp-action="Returns" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-arrow-left-right me-2"></i> 采购退换
                            </a>
                        }
                    </div>
                }
                @if (canViewSales)
                {
                    <a class="list-group-item list-group-item-action bg-dark text-white border-0 d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse" href="#salesMenu" role="button" aria-expanded="@(isSalesMenuOpen ? "true" : "false")" aria-controls="salesMenu">
                        <span><i class="bi bi-cart3 me-2"></i> @Localizer["Layout_Sales"]</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                    <div class="collapse @(isSalesMenuOpen ? "show" : string.Empty)" id="salesMenu">
                        @if (canViewSalesQuotations)
                        {
                            <a asp-area="Sales" asp-controller="SalesQuotations" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-chat-square-quote me-2"></i> 销售报价
                            </a>
                        }
                        @if (canViewSalesOrders)
                        {
                            <a asp-area="Sales" asp-controller="SalesOrders" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-receipt-cutoff me-2"></i> 销售订单
                            </a>
                        }
                        @if (canViewSalesDeliveries)
                        {
                            <a asp-area="Sales" asp-controller="SalesManagement" asp-action="Deliveries" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-truck me-2"></i> 销售送货
                            </a>
                        }
                        @if (canViewSalesInvoices)
                        {
                            <a asp-area="Sales" asp-controller="SalesManagement" asp-action="Invoices" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-journal-text me-2"></i> 销售发票
                            </a>
                        }
                        @if (canViewSalesReceipts)
                        {
                            <a asp-area="Sales" asp-controller="SalesManagement" asp-action="Receipts" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-cash-coin me-2"></i> 销售收款
                            </a>
                        }
                        @if (canViewSalesAdvanceReceipts)
                        {
                            <a asp-area="Sales" asp-controller="SalesManagement" asp-action="AdvanceReceipts" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-wallet2 me-2"></i> 预收款
                            </a>
                        }
                        @if (canViewSalesReturns)
                        {
                            <a asp-area="Sales" asp-controller="SalesManagement" asp-action="Returns" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-arrow-left-right me-2"></i> 销售退换
                            </a>
                        }
                        @if (canViewSalesRecurringInvoices)
                        {
                            <a asp-area="Sales" asp-controller="SalesManagement" asp-action="RecurringInvoices" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-calendar2-week me-2"></i> 定期发票
                            </a>
                        }
                    </div>
                }
                @if (canViewLogistics)
                {
                    <a class="list-group-item list-group-item-action bg-dark text-white border-0 d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse" href="#logisticsMenu" role="button" aria-expanded="@(isLogisticsMenuOpen ? "true" : "false")" aria-controls="logisticsMenu">
                        <span><i class="bi bi-box-seam me-2"></i> @Localizer["Layout_Logistics"]</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                    <div class="collapse @(isLogisticsMenuOpen ? "show" : string.Empty)" id="logisticsMenu">
                        @if (canViewWorkshopWarehouses)
                        {
                            <a asp-area="Logistics" asp-controller="WorkshopWarehouses" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5">
                                <i class="bi bi-boxes me-2"></i> 车间仓库
                            </a>
                        }
                        @if (canViewLogisticsMaterialManagement)
                        {
                            <a class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" href="#logisticsMaterialManagementMenu" role="button" aria-expanded="@(isLogisticsMaterialManagementMenuOpen ? "true" : "false")" aria-controls="logisticsMaterialManagementMenu">
                                <span><i class="bi bi-grid-3x3-gap me-2"></i> 物料管理</span>
                                <i class="bi bi-chevron-down small"></i>
                            </a>
                            <div class="collapse @(isLogisticsMaterialManagementMenuOpen ? "show" : string.Empty)" id="logisticsMaterialManagementMenu">
                                @if (canViewLogisticsProducts)
                                {
                                    <a asp-area="Logistics" asp-controller="MaterialManagement" asp-action="Products" class="list-group-item list-group-item-action bg-dark text-white border-0 ps-5 ms-3">
                                        <i class="bi bi-box me-2"></i> 产品
                                    </a>
                                }
