    // 应付账权限（用于显示付款管理下的应付账菜单，父级付款管理权限可继承显示）。
    var canViewFinanceAccountsPayable = HasPermission("FINANCE", "FINANCE_PAYMENTS", "FINANCE_ACCOUNTS_PAYABLE");
    // 贷记单权限（用于显示付款管理下的贷记单菜单，父级付款管理权限可继承显示）。
    var canViewFinanceCreditNotes = HasPermission("FINANCE", "FINANCE_PAYMENTS", "FINANCE_CREDIT_NOTES");
    // 预付款权限（用于显示付款管理下的预付款菜单，父级付款管理权限可继承显示）。
