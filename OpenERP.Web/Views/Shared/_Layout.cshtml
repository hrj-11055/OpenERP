        <div class="page-popup-lock page-popup-lock--modal" id="company-switch-lock" hidden>
            <div class="page-popup-lock__dialog company-switch-dialog" role="dialog" aria-modal="true" aria-labelledby="company-switch-title">
                <div class="page-popup-lock__dialog-header company-switch-dialog__header">
                    <div class="page-popup-lock__dialog-title" id="company-switch-title">开单公司</div>
                    <button type="button" class="page-popup-lock__dialog-close" id="company-switch-close" aria-label="关闭">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="page-popup-lock__dialog-body company-switch-dialog__body">
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="SwitchCompany"
                          method="post"
                          id="company-switch-form"
                          class="company-switch-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <div class="company-switch-form__actions">
                            <button type="submit" class="btn btn-primary btn-sm">确定</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="company-switch-cancel">关闭</button>
                        </div>

                        @if (shouldRestrictCompanyOptions)
                        {
                            <div class="text-muted small mb-2">仅显示当前账号已配置管辖权限的公司组织。</div>
                        }

                        <div class="company-switch-table-shell">
                            <table class="table company-switch-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">序号</th>
                                        <th scope="col">公司编号</th>
                                        <th scope="col">公司名称</th>
                                        <th scope="col">拥有权限</th>
                                        <th scope="col">当前开单公司</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var index = 0; index < companyOptions.Length; index++)
                                    {
                                        var option = companyOptions[index];
                                        var isCurrentCompany = string.Equals(option.Value, currentCompany.Value, StringComparison.OrdinalIgnoreCase);
                                        <tr>
                                            <td>@(index + 1)</td>
                                            <td>@option.Code</td>
                                            <td>@option.Text</td>
                                            <td>
                                                <span class="company-switch-table__permission">
                                                    <input type="checkbox" checked="checked" disabled="disabled" />
                                                    <span>查看</span>
                                                </span>
                                                <span class="company-switch-table__permission">
                                                    <input type="checkbox" checked="checked" disabled="disabled" />
                                                    <span>操作</span>
                                                </span>
                                            </td>
                                            <td>
                                                <input type="radio"
                                                       name="company"
                                                       value="@option.Value"
                                                       checked="@isCurrentCompany"
                                                       aria-label="选择 @option.Text 作为当前开单公司" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="layout-shell__main" id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom layout-shell__navbar">
                <div class="container-fluid gap-3">
                    <button class="btn btn-primary" id="menu-toggle" type="button">@Localizer["Layout_ToggleMenu"]</button>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <div class="ms-auto d-flex flex-column flex-lg-row align-items-lg-center gap-3 mt-3 mt-lg-0">
                            @* 顶部快捷功能组：先提供快速查单、查看信息、设置入口，后续再补业务逻辑 *@
                            <div class="layout-shell__header-tools" aria-label="系统快捷功能">
                                <div class="layout-shell__quick-search">
                                    <input type="search"
                                           class="form-control form-control-sm layout-shell__quick-search-input"
                                           placeholder="快速查单单号"
                                           aria-label="快速查单单号" />
                                    <button type="button"
                                            class="layout-shell__quick-search-button"
                                            title="快速查单"
                                            aria-label="快速查单">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <button type="button"
                                        class="layout-shell__icon-action"
                                        title="查看信息"
                                        aria-label="查看信息">
                                    <i class="bi bi-bell"></i>
                                </button>
                                <button type="button"
                                        class="layout-shell__icon-action"
                                        title="设置"
                                        aria-label="设置">
                                    <i class="bi bi-gear"></i>
                                </button>
                            </div>
                            <form asp-area="" asp-controller="Home" asp-action="SetLanguage" method="post" class="language-switcher-form notranslate" translate="no">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <label class="language-switcher-label" for="culture">@Localizer["Layout_Language"]</label>
                                <select id="culture" name="culture" class="form-select form-select-sm language-switcher-select" onchange="this.form.submit()" translate="no">
                                    <option value="zh-Hans" selected="@(currentCulture == "zh-Hans" ? "selected" : null)">@Localizer["Language_SimplifiedChinese"]</option>
                                    <option value="zh-Hant" selected="@(currentCulture == "zh-Hant" ? "selected" : null)">@Localizer["Language_TraditionalChinese"]</option>
                                    <option value="en" selected="@(currentCulture == "en" ? "selected" : null)">@Localizer["Language_English"]</option>
                                </select>
                            </form>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline layout-shell__logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="layout-shell__icon-action layout-shell__logout-action"
                                        title="@Localizer["Layout_Logout"]"
                                        aria-label="@Localizer["Layout_Logout"]">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>

            <div class="page-tabs-shell layout-shell__tabs">
                <div id="page-tabs-bar"
                     class="page-tabs-bar"
                     data-current-url="@returnUrl"
                     data-current-title="@currentPageTitle"
                     data-home-url="@homeUrl">
                </div>
            </div>

            <div class="container-fluid p-4 layout-shell__content">
                <main role="main" class="company-print-page">
                    @RenderBody()
                </main>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $("#menu-toggle").click(function (e) {
            e.preventDefault();
            $("#sidebar-wrapper").toggle();
        });

        (() => {
            const companySwitchTrigger = document.getElementById("company-switch-trigger");
            const companySwitchLock = document.getElementById("company-switch-lock");
            const companySwitchClose = document.getElementById("company-switch-close");
            const companySwitchCancel = document.getElementById("company-switch-cancel");

            if (!companySwitchTrigger || !companySwitchLock) {
                return;
            }

            // 开单公司切换窗：点击左下角公司标签时弹出，确认后切换当前业务公司。
            function setCompanySwitchOpen(isOpen) {
                companySwitchTrigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
                companySwitchLock.hidden = !isOpen;
            }

            companySwitchTrigger.addEventListener("click", () => {
                const isOpen = companySwitchTrigger.getAttribute("aria-expanded") === "true";
                setCompanySwitchOpen(!isOpen);
            });

            companySwitchClose?.addEventListener("click", () => setCompanySwitchOpen(false));
            companySwitchCancel?.addEventListener("click", () => setCompanySwitchOpen(false));

            companySwitchLock.addEventListener("click", event => {
                if (event.target === companySwitchLock) {
                    setCompanySwitchOpen(false);
                }
            });

            document.addEventListener("keydown", event => {
                if (event.key === "Escape") {
                    setCompanySwitchOpen(false);
                }
            });
        })();

        (() => {
            const sidebarUserShell = document.getElementById("sidebar-user-menu-shell");
            const sidebarUserTrigger = document.getElementById("sidebar-user-menu-trigger");
            const sidebarUserMenu = document.getElementById("sidebar-user-menu");

            if (!sidebarUserShell || !sidebarUserTrigger || !sidebarUserMenu) {
                return;
            }

            // 左下角用户菜单：点击头像或姓名时在右侧展开菜单。
            function setSidebarUserMenuOpen(isOpen) {
                sidebarUserTrigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
                sidebarUserMenu.hidden = !isOpen;
            }

            sidebarUserTrigger.addEventListener("click", () => {
                const isOpen = sidebarUserTrigger.getAttribute("aria-expanded") === "true";
                setSidebarUserMenuOpen(!isOpen);
            });

            const sidebarMenuActionButtons = sidebarUserMenu.querySelectorAll(".layout-shell__sidebar-user-menu-item");
            if (sidebarMenuActionButtons.length > 1) {
                sidebarMenuActionButtons[1].addEventListener("click", () => {
                    window.location.href = '@Url.Action("ChangePassword", "Account", new { area = "" })';
                });
            }

            document.addEventListener("click", (event) => {
                if (!sidebarUserShell.contains(event.target)) {
                    setSidebarUserMenuOpen(false);
                }
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    setSidebarUserMenuOpen(false);
                }
            });
        })();

        (() => {
            const pageTabsBar = document.getElementById("page-tabs-bar");
            if (!pageTabsBar) {
                return;
            }

            // 页签缓存键（用于保存当前已打开的顶部页签集合）。
            const storageKey = "openErp.pageTabs";

            // 页签状态参数（只影响当前列表选择，不代表新的功能页）。
            const tabStateQueryKeys = new Set(["selectedCustomerId", "selectedWarehouseId"]);
            // 默认查询范围（空关键字时与不带 scope 参数等价）。
            const defaultSearchScope = "全部";

            // 当前页面页签信息（来自布局数据属性）。
            const currentUrl = normalizeUrl(pageTabsBar.dataset.currentUrl || "/");
            const currentTitle = (pageTabsBar.dataset.currentTitle || "Open ERP").trim();
            const homeUrl = normalizeUrl(pageTabsBar.dataset.homeUrl || "/");

            // 统一标准化站内地址，避免同一路由因绝对/相对路径或列表选中态不同而重复建页签。
            function normalizeUrl(url) {
                try {
                    const parsedUrl = new URL(url, window.location.origin);
                    tabStateQueryKeys.forEach(key => parsedUrl.searchParams.delete(key));
                    const keyword = (parsedUrl.searchParams.get("keyword") || "").trim();
                    const scope = (parsedUrl.searchParams.get("scope") || "").trim();

                    if (!keyword) {
                        parsedUrl.searchParams.delete("keyword");
                    }

                    if (!scope || (!keyword && scope === defaultSearchScope)) {
                        parsedUrl.searchParams.delete("scope");
                    }

                    const queryString = parsedUrl.searchParams.toString();
                    return `${parsedUrl.pathname}${queryString ? `?${queryString}` : ""}`;
                } catch {
                    return url || "/";
                }
            }

            // 合并历史缓存中的同功能页签，清理已经产生的重复页签。
            function normalizeTabs(tabs) {
                const normalizedTabs = [];
                const tabIndexMap = new Map();

                tabs
                    .filter(tab => tab && typeof tab.url === "string" && typeof tab.title === "string")
                    .forEach(tab => {
                        const tabUrl = normalizeUrl(tab.url);
                        const normalizedTab = {
                            url: tabUrl,
                            title: tab.title
                        };
                        const existingIndex = tabIndexMap.get(tabUrl);

                        if (existingIndex === undefined) {
                            tabIndexMap.set(tabUrl, normalizedTabs.length);
                            normalizedTabs.push(normalizedTab);
                            return;
                        }

                        normalizedTabs[existingIndex] = normalizedTab;
                    });

                return normalizedTabs;
            }

            // 读取浏览器缓存中的页签列表。
            function readTabs() {
                try {
                    const rawValue = sessionStorage.getItem(storageKey);
                    if (!rawValue) {
                        return [];
                    }

                    const parsedTabs = JSON.parse(rawValue);
                    return Array.isArray(parsedTabs) ? parsedTabs : [];
                } catch {
                    return [];
                }
            }

            // 写回最新页签列表。
            function writeTabs(tabs) {
                sessionStorage.setItem(storageKey, JSON.stringify(tabs));
            }

            // 将当前页面登记为顶部页签，已存在时只刷新标题。
            function upsertCurrentTab() {
                const tabs = normalizeTabs(readTabs());
                const existingTab = tabs.find(tab => tab.url === currentUrl);

                if (existingTab) {
                    existingTab.url = currentUrl;
                    existingTab.title = currentTitle;
                } else {
                    tabs.push({
                        url: currentUrl,
                        title: currentTitle
                    });
                }

                writeTabs(tabs);
                return tabs;
            }

            // 渲染顶部可切换、可关闭的页签卡。
            function renderTabs(tabs) {
                pageTabsBar.innerHTML = "";

                tabs.forEach(tab => {
                    const tabUrl = normalizeUrl(tab.url);
                    const tabItem = document.createElement("div");
                    const tabLink = document.createElement("a");
                    const closeButton = document.createElement("button");

                    tabItem.className = "page-tab-card";
                    if (tabUrl === currentUrl) {
                        tabItem.classList.add("is-active");
                    }

                    tabLink.className = "page-tab-card__link";
                    tabLink.href = tabUrl;
                    tabLink.textContent = tab.title;

                    closeButton.type = "button";
                    closeButton.className = "page-tab-card__close";
                    closeButton.dataset.url = tabUrl;
                    closeButton.setAttribute("aria-label", `关闭 ${tab.title}`);
                    closeButton.innerHTML = "&times;";

                    tabItem.appendChild(tabLink);
                    tabItem.appendChild(closeButton);
                    pageTabsBar.appendChild(tabItem);
                });
            }

            // 关闭指定页签，若关闭当前页则自动跳到前一个页签或首页。
            function closeTab(targetUrl) {
                const tabs = normalizeTabs(readTabs());
                const targetIndex = tabs.findIndex(tab => tab.url === targetUrl);

                if (targetIndex < 0) {
                    return;
                }

                const fallbackTab = tabs[targetIndex - 1] ?? tabs[targetIndex + 1];
                const isClosingCurrentTab = targetUrl === currentUrl;

                tabs.splice(targetIndex, 1);
                writeTabs(tabs);

                if (isClosingCurrentTab) {
                    window.location.href = fallbackTab ? normalizeUrl(fallbackTab.url) : homeUrl;
                    return;
                }

                renderTabs(tabs);
            }

            const tabs = upsertCurrentTab();
            renderTabs(tabs);

            pageTabsBar.addEventListener("click", event => {
                const closeButton = event.target.closest(".page-tab-card__close");
                if (!closeButton) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                closeTab(normalizeUrl(closeButton.dataset.url || ""));
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
