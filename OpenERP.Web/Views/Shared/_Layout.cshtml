@using System.Globalization
@using System.Security.Claims
@inject OpenERP.Web.Data.HR.IHrRepository HrRepository
@inject OpenERP.Web.Printing.ICompanyPrintTemplateService CompanyPrintTemplateService
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentPageTitle = ViewData["Title"]?.ToString() ?? Localizer["AppName"].Value;
    var homeUrl = Url.Action("Index", "Home", new { area = "" }) ?? "/";
    var currentAccount = User.FindFirst("erp:account")?.Value;
    var currentCompanyValue = User.FindFirst("erp:company")?.Value ?? "HQ";
    var shouldRestrictCompanyOptions = !string.IsNullOrWhiteSpace(currentAccount)
        && !string.Equals(currentAccount, "admin", StringComparison.OrdinalIgnoreCase);
    var currentEmployee = default(OpenERP.HR.Models.Entities.Employee);
    var allowedCompanyCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var effectivePermissionCodes = new HashSet<string>(
        User.FindAll("erp:permission")
            .Select(claim => claim.Value)
            .Where(value => !string.IsNullOrWhiteSpace(value)),
        StringComparer.OrdinalIgnoreCase);
    if (shouldRestrictCompanyOptions)
    {
        currentEmployee = await HrRepository.GetEmployeeByLoginAccountAsync(currentAccount!);
        if (currentEmployee is not null)
        {
            foreach (var code in await HrRepository.GetUserCompanyCodesAsync(currentEmployee.Id))
            {
                if (!string.IsNullOrWhiteSpace(code))
                {
                    allowedCompanyCodes.Add(code);
                }
            }

            // 数据库有效权限（用于合并登录后新增或调整的菜单权限，避免旧 Cookie 漏显示新功能）。
            foreach (var permissionCode in await HrRepository.GetEffectivePermissionCodesAsync(currentEmployee.Id))
            {
                if (!string.IsNullOrWhiteSpace(permissionCode))
                {
                    effectivePermissionCodes.Add(permissionCode);
                }
            }
        }
    }
    bool HasPermission(params string[] permissionCodes)
        => !shouldRestrictCompanyOptions || permissionCodes.Any(code => effectivePermissionCodes.Contains(code));
    var canViewDashboard = HasPermission("DASHBOARD");
    // 供应商/厂商资料权限（用于显示供应链管理下的供应商/厂商资料菜单）。
    var canViewPurchasingSuppliers = HasPermission("PURCHASING", "PURCHASING_SUPPLIERS");
    // 合约管理权限（用于显示供应链管理下的合约管理菜单）。
    var canViewPurchasingContracts = HasPermission("PURCHASING", "PURCHASING_CONTRACTS");
    // 采购询价权限（用于显示供应链管理下的采购询价菜单）。
    var canViewPurchasingInquiries = HasPermission("PURCHASING", "PURCHASING_INQUIRIES");
    // 采购订单权限（用于显示供应链管理下的采购订单菜单）。
    var canViewPurchasingPurchaseOrders = HasPermission("PURCHASING", "PURCHASING_PURCHASE_ORDERS");
    // 采购发票权限（用于显示供应链管理下的采购发票菜单）。
    var canViewPurchasingInvoices = HasPermission("PURCHASING", "PURCHASING_INVOICES");
    // 采购付款权限（用于显示供应链管理下的采购付款菜单）。
    var canViewPurchasingPayments = HasPermission("PURCHASING", "PURCHASING_PAYMENTS");
    // 预付款权限（用于显示供应链管理下的预付款菜单）。
    var canViewPurchasingPrepayments = HasPermission("PURCHASING", "PURCHASING_PREPAYMENTS");
    // 采购退换权限（用于显示供应链管理下的采购退换菜单）。
    var canViewPurchasingReturns = HasPermission("PURCHASING", "PURCHASING_RETURNS");
    // 供应链管理父级菜单权限（用于承载采购相关子功能）。
    var canViewPurchasing = canViewPurchasingSuppliers
        || canViewPurchasingContracts
        || canViewPurchasingInquiries
        || canViewPurchasingPurchaseOrders
        || canViewPurchasingInvoices
        || canViewPurchasingPayments
        || canViewPurchasingPrepayments
        || canViewPurchasingReturns;
    // 供应链管理菜单展开状态（进入采购区域时自动展开子功能）。
    var isPurchasingMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "Purchasing", StringComparison.OrdinalIgnoreCase);
    // 销售报价权限（用于显示销售管理下的销售报价菜单）。
    var canViewSalesQuotations = HasPermission("SALES", "SALES_QUOTATIONS");
    // 销售订单权限（用于显示销售管理下的销售订单菜单）。
    var canViewSalesOrders = HasPermission("SALES", "SALES_SALES_ORDERS");
    // 销售送货权限（用于显示销售管理下的销售送货菜单）。
    var canViewSalesDeliveries = HasPermission("SALES", "SALES_DELIVERIES");
    // 销售发票权限（用于显示销售管理下的销售发票菜单）。
    var canViewSalesInvoices = HasPermission("SALES", "SALES_INVOICES");
    // 销售收款权限（用于显示销售管理下的销售收款菜单）。
    var canViewSalesReceipts = HasPermission("SALES", "SALES_RECEIPTS");
    // 预收款权限（用于显示销售管理下的预收款菜单）。
    var canViewSalesAdvanceReceipts = HasPermission("SALES", "SALES_ADVANCE_RECEIPTS");
    // 销售退换权限（用于显示销售管理下的销售退换菜单）。
    var canViewSalesReturns = HasPermission("SALES", "SALES_RETURNS");
    // 定期发票权限（用于显示销售管理下的定期发票菜单）。
    var canViewSalesRecurringInvoices = HasPermission("SALES", "SALES_RECURRING_INVOICES");
    // 销售管理父级菜单权限（用于承载销售相关子功能）。
    var canViewSales = canViewSalesQuotations
        || canViewSalesOrders
        || canViewSalesDeliveries
        || canViewSalesInvoices
        || canViewSalesReceipts
        || canViewSalesAdvanceReceipts
        || canViewSalesReturns
        || canViewSalesRecurringInvoices;
    // 销售管理菜单展开状态（进入销售区域时自动展开子功能）。
    var isSalesMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "Sales", StringComparison.OrdinalIgnoreCase);
    // 车间仓库子功能权限（用于显示仓务管理下的车间仓库菜单）。
    var canViewWorkshopWarehouses = HasPermission("LOGISTICS", "LOGISTICS_WORKSHOP_WAREHOUSES");
    // 产品资料子功能权限（用于显示物料管理下的产品菜单）。
    var canViewLogisticsProducts = HasPermission("LOGISTICS", "LOGISTICS_MATERIAL_MANAGEMENT", "LOGISTICS_PRODUCTS");
    // 材料资料子功能权限（用于显示物料管理下的材料菜单）。
    var canViewLogisticsMaterials = HasPermission("LOGISTICS", "LOGISTICS_MATERIAL_MANAGEMENT", "LOGISTICS_MATERIALS");
    // 辅料资料子功能权限（用于显示物料管理下的辅料菜单）。
    var canViewLogisticsAuxiliaryMaterials = HasPermission("LOGISTICS", "LOGISTICS_MATERIAL_MANAGEMENT", "LOGISTICS_AUXILIARY_MATERIALS");
    // 物料管理父级菜单权限（用于承载产品、材料、辅料子功能）。
    var canViewLogisticsMaterialManagement = HasPermission("LOGISTICS", "LOGISTICS_MATERIAL_MANAGEMENT")
        || canViewLogisticsProducts
        || canViewLogisticsMaterials
        || canViewLogisticsAuxiliaryMaterials;
    // 产品库存权限（用于显示库存查询下的产品库存菜单）。
    var canViewLogisticsProductInventory = HasPermission("LOGISTICS", "LOGISTICS_INVENTORY_QUERY", "LOGISTICS_PRODUCT_INVENTORY");
    // 材料库存权限（用于显示库存查询下的材料库存菜单）。
    var canViewLogisticsMaterialInventory = HasPermission("LOGISTICS", "LOGISTICS_INVENTORY_QUERY", "LOGISTICS_MATERIAL_INVENTORY");
    // 辅料库存权限（用于显示库存查询下的辅料库存菜单）。
    var canViewLogisticsAuxiliaryMaterialInventory = HasPermission("LOGISTICS", "LOGISTICS_INVENTORY_QUERY", "LOGISTICS_AUXILIARY_MATERIAL_INVENTORY");
    // 库存查询权限（用于显示仓务管理下的库存查询折叠菜单）。
    var canViewLogisticsInventoryQuery = HasPermission("LOGISTICS", "LOGISTICS_INVENTORY_QUERY")
        || canViewLogisticsProductInventory
        || canViewLogisticsMaterialInventory
        || canViewLogisticsAuxiliaryMaterialInventory;
    // 收货通知权限（用于显示入库管理下的收货通知菜单）。
    var canViewLogisticsReceivingNotices = HasPermission("LOGISTICS", "LOGISTICS_INBOUND_MANAGEMENT", "LOGISTICS_RECEIVING_NOTICES");
    // 入库核实权限（用于显示入库管理下的入库核实菜单）。
    var canViewLogisticsInboundVerifications = HasPermission("LOGISTICS", "LOGISTICS_INBOUND_MANAGEMENT", "LOGISTICS_INBOUND_VERIFICATIONS");
    // 入库IQC权限（用于显示入库管理下的入库IQC菜单）。
    var canViewLogisticsInboundIqc = HasPermission("LOGISTICS", "LOGISTICS_INBOUND_MANAGEMENT", "LOGISTICS_INBOUND_IQC");
    // 入库单权限（用于显示入库管理下的入库单菜单）。
    var canViewLogisticsInboundOrders = HasPermission("LOGISTICS", "LOGISTICS_INBOUND_MANAGEMENT", "LOGISTICS_INBOUND_ORDERS");
    // 入库记录权限（用于显示入库管理下的入库记录菜单）。
    var canViewLogisticsInboundRecords = HasPermission("LOGISTICS", "LOGISTICS_INBOUND_MANAGEMENT", "LOGISTICS_INBOUND_RECORDS");
    // 入库管理权限（用于显示仓务管理下的入库管理折叠菜单）。
    var canViewLogisticsInboundManagement = HasPermission("LOGISTICS", "LOGISTICS_INBOUND_MANAGEMENT")
        || canViewLogisticsReceivingNotices
        || canViewLogisticsInboundVerifications
        || canViewLogisticsInboundIqc
        || canViewLogisticsInboundOrders
        || canViewLogisticsInboundRecords;
    // 出货通知权限（用于显示出库管理下的出货通知菜单，父级出库管理权限可继承显示）。
    var canViewLogisticsShippingNotices = HasPermission("LOGISTICS", "LOGISTICS_OUTBOUND_MANAGEMENT", "LOGISTICS_SHIPPING_NOTICES");
    // 出库核实权限（用于显示出库管理下的出库核实菜单，父级出库管理权限可继承显示）。
    var canViewLogisticsOutboundVerifications = HasPermission("LOGISTICS", "LOGISTICS_OUTBOUND_MANAGEMENT", "LOGISTICS_OUTBOUND_VERIFICATIONS");
    // 出库单权限（用于显示出库管理下的出库单菜单，父级出库管理权限可继承显示）。
    var canViewLogisticsOutboundOrders = HasPermission("LOGISTICS", "LOGISTICS_OUTBOUND_MANAGEMENT", "LOGISTICS_OUTBOUND_ORDERS");
    // 出库记录权限（用于显示出库管理下的出库记录菜单，父级出库管理权限可继承显示）。
    var canViewLogisticsOutboundRecords = HasPermission("LOGISTICS", "LOGISTICS_OUTBOUND_MANAGEMENT", "LOGISTICS_OUTBOUND_RECORDS");
    // 出库管理权限（用于显示仓务管理下的出库管理父级菜单）。
    var canViewLogisticsOutboundManagement = HasPermission("LOGISTICS", "LOGISTICS_OUTBOUND_MANAGEMENT")
        || canViewLogisticsShippingNotices
        || canViewLogisticsOutboundVerifications
        || canViewLogisticsOutboundOrders
        || canViewLogisticsOutboundRecords;
    // 领料单权限（用于显示仓务管理下的领料单菜单）。
    var canViewLogisticsMaterialRequisitions = HasPermission("LOGISTICS", "LOGISTICS_MATERIAL_REQUISITIONS");
    // 退货单权限（用于显示仓务管理下的退货单菜单）。
    var canViewLogisticsReturnOrders = HasPermission("LOGISTICS", "LOGISTICS_RETURN_ORDERS");
    // 调拨单权限（用于显示仓务管理下的调拨单菜单）。
    var canViewLogisticsTransferOrders = HasPermission("LOGISTICS", "LOGISTICS_TRANSFER_ORDERS");
    // 补货单权限（用于显示仓务管理下的补货单菜单）。
    var canViewLogisticsReplenishmentOrders = HasPermission("LOGISTICS", "LOGISTICS_REPLENISHMENT_ORDERS");
    // 转位单权限（用于显示仓务管理下的转位单菜单）。
    var canViewLogisticsRelocationOrders = HasPermission("LOGISTICS", "LOGISTICS_RELOCATION_ORDERS");
    // 调整单权限（用于显示仓务管理下的调整单菜单）。
    var canViewLogisticsAdjustmentOrders = HasPermission("LOGISTICS", "LOGISTICS_ADJUSTMENT_ORDERS");
    // 盘点单权限（用于显示盘点管理下的盘点单菜单，父级盘点管理权限可继承显示）。
    var canViewLogisticsStocktakeOrders = HasPermission("LOGISTICS", "LOGISTICS_STOCKTAKES", "LOGISTICS_STOCKTAKE_ORDERS");
    // 周期盘点计划权限（用于显示盘点管理下的周期盘点计划菜单，父级盘点管理权限可继承显示）。
    var canViewLogisticsCycleCountPlans = HasPermission("LOGISTICS", "LOGISTICS_STOCKTAKES", "LOGISTICS_CYCLE_COUNT_PLANS");
    // 盘点管理权限（用于显示仓务管理下的盘点管理父级菜单）。
    var canViewLogisticsStocktakes = HasPermission("LOGISTICS", "LOGISTICS_STOCKTAKES")
        || canViewLogisticsStocktakeOrders
        || canViewLogisticsCycleCountPlans;
    // 批次管理权限（用于显示仓务管理下的批次管理菜单）。
    var canViewLogisticsBatches = HasPermission("LOGISTICS", "LOGISTICS_BATCHES");
    // RFID记录权限（用于显示仓务管理下的射频识别记录菜单）。
    var canViewLogisticsRfidRecords = HasPermission("LOGISTICS", "LOGISTICS_RFID_RECORDS");
    // 仓务操作菜单权限（用于承载库存、出入库和仓务单据子功能）。
    var canViewLogisticsWarehouseOperations = canViewLogisticsInventoryQuery
        || canViewLogisticsInboundManagement
        || canViewLogisticsOutboundManagement
        || canViewLogisticsMaterialRequisitions
        || canViewLogisticsReturnOrders
        || canViewLogisticsTransferOrders
        || canViewLogisticsReplenishmentOrders
        || canViewLogisticsRelocationOrders
        || canViewLogisticsAdjustmentOrders
        || canViewLogisticsStocktakes
        || canViewLogisticsBatches
        || canViewLogisticsRfidRecords;
    // 仓务管理父级菜单权限（用于承载仓务相关子功能）。
    var canViewLogistics = HasPermission("LOGISTICS", "LOGISTICS_CARRIERS")
        || canViewWorkshopWarehouses
        || canViewLogisticsMaterialManagement
        || canViewLogisticsWarehouseOperations;
    // 仓务管理菜单展开状态（进入仓务管理区域时自动展开子功能）。
    var isLogisticsMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "Logistics", StringComparison.OrdinalIgnoreCase);
    // 物料管理菜单展开状态（进入产品、材料、辅料页面时自动展开子功能）。
    var currentLogisticsController = Context.Request.RouteValues["controller"]?.ToString();
    var currentLogisticsAction = Context.Request.RouteValues["action"]?.ToString();
    var isLogisticsMaterialManagementMenuOpen = isLogisticsMenuOpen
        && string.Equals(currentLogisticsController, "MaterialManagement", StringComparison.OrdinalIgnoreCase);
    // 库存查询菜单展开状态（进入产品库存、材料库存或辅料库存页面时自动展开子功能）。
    var isLogisticsInventoryQueryMenuOpen = isLogisticsMenuOpen
        && string.Equals(currentLogisticsController, "WarehouseOperations", StringComparison.OrdinalIgnoreCase)
        && new[] { "ProductInventory", "MaterialInventory", "AuxiliaryMaterialInventory" }
            .Contains(currentLogisticsAction, StringComparer.OrdinalIgnoreCase);
    // 入库管理菜单展开状态（进入收货通知、入库核实、入库IQC、入库单或入库记录页面时自动展开子功能）。
    var isLogisticsInboundManagementMenuOpen = isLogisticsMenuOpen
        && string.Equals(currentLogisticsController, "WarehouseOperations", StringComparison.OrdinalIgnoreCase)
        && new[] { "ReceivingNotices", "InboundVerifications", "InboundIqc", "InboundOrders", "InboundRecords" }
            .Contains(currentLogisticsAction, StringComparer.OrdinalIgnoreCase);
    // 出库管理菜单展开状态（进入出货通知、出库核实、出库单或出库记录页面时自动展开子功能）。
    var isLogisticsOutboundManagementMenuOpen = isLogisticsMenuOpen
        && string.Equals(currentLogisticsController, "WarehouseOperations", StringComparison.OrdinalIgnoreCase)
        && new[] { "ShippingNotices", "OutboundVerifications", "OutboundOrders", "OutboundRecords" }
            .Contains(currentLogisticsAction, StringComparer.OrdinalIgnoreCase);
    // 盘点管理菜单展开状态（进入盘点单或周期盘点计划页面时自动展开子功能）。
    var isLogisticsStocktakeManagementMenuOpen = isLogisticsMenuOpen
        && string.Equals(currentLogisticsController, "WarehouseOperations", StringComparison.OrdinalIgnoreCase)
        && new[] { "StocktakeOrders", "CycleCountPlans" }
            .Contains(currentLogisticsAction, StringComparer.OrdinalIgnoreCase);
    // 生产设备权限（用于显示生产管理下的生产设备菜单）。
    var canViewProductionEquipment = HasPermission("PRODUCTION", "PRODUCTION_EQUIPMENT");
    // 工序管理权限（用于显示生产管理下的工序管理菜单）。
    var canViewProductionProcesses = HasPermission("PRODUCTION", "PRODUCTION_PROCESSES");
    // 样板工单权限（用于显示生产管理下的样板工单菜单）。
    var canViewProductionSampleWorkOrders = HasPermission("PRODUCTION", "PRODUCTION_SAMPLE_WORK_ORDERS");
    // 生产工单权限（用于显示生产管理下的生产工单菜单）。
    var canViewProductionWorkOrders = HasPermission("PRODUCTION", "PRODUCTION_ORDERS");
    // 排产计划权限（用于显示生产管理下的排产计划菜单）。
    var canViewProductionSchedulingPlans = HasPermission("PRODUCTION", "PRODUCTION_SCHEDULING_PLANS");
    // 工件录入权限（用于显示生产管理下的工件录入菜单）。
    var canViewProductionWorkpieceEntries = HasPermission("PRODUCTION", "PRODUCTION_WORKPIECE_ENTRIES");
    // 生产进度权限（用于显示生产管理下的生产进度菜单）。
    var canViewProductionProgress = HasPermission("PRODUCTION", "PRODUCTION_PROGRESS");
    // 成品拆解权限（用于显示生产管理下的成品拆解菜单）。
    var canViewProductionFinishedProductDisassembly = HasPermission("PRODUCTION", "PRODUCTION_FINISHED_PRODUCT_DISASSEMBLY");
    // 成品组装权限（用于显示生产管理下的成品组装菜单）。
    var canViewProductionFinishedProductAssembly = HasPermission("PRODUCTION", "PRODUCTION_FINISHED_PRODUCT_ASSEMBLY");
    // 外发加工权限（用于显示生产管理下的外发加工菜单）。
    var canViewProductionOutsourcedProcessing = HasPermission("PRODUCTION", "PRODUCTION_OUTSOURCED_PROCESSING");
    // 生产管理父级菜单权限（用于承载生产相关子功能）。
    var canViewProduction = canViewProductionEquipment
        || canViewProductionProcesses
        || canViewProductionSampleWorkOrders
        || canViewProductionWorkOrders
        || canViewProductionSchedulingPlans
        || canViewProductionWorkpieceEntries
        || canViewProductionProgress
        || canViewProductionFinishedProductDisassembly
        || canViewProductionFinishedProductAssembly
        || canViewProductionOutsourcedProcessing;
    // 生产管理菜单展开状态（进入生产区域时自动展开子功能）。
    var isProductionMenuOpen = string.Equals(Context.Request.RouteValues["area"]?.ToString(), "Production", StringComparison.OrdinalIgnoreCase);
    // 科目资料权限（用于显示财务管理下的科目资料菜单）。
    var canViewFinanceAccounts = HasPermission("FINANCE", "FINANCE_ACCOUNTS");
    // 应收账权限（用于显示收款管理下的应收账菜单，父级收款管理权限可继承显示）。
    var canViewFinanceAccountsReceivable = HasPermission("FINANCE", "FINANCE_RECEIPTS", "FINANCE_ACCOUNTS_RECEIVABLE");
    // 借记单权限（用于显示收款管理下的借记单菜单，父级收款管理权限可继承显示）。
    var canViewFinanceDebitNotes = HasPermission("FINANCE", "FINANCE_RECEIPTS", "FINANCE_DEBIT_NOTES");
    // 预收款权限（用于显示收款管理下的预收款菜单，父级收款管理权限可继承显示）。
    var canViewFinanceAdvanceReceipts = HasPermission("FINANCE", "FINANCE_RECEIPTS", "FINANCE_ADVANCE_RECEIPTS");
    // 收款单权限（用于显示收款管理下的收款单菜单，父级收款管理权限可继承显示）。
    var canViewFinanceReceiptOrders = HasPermission("FINANCE", "FINANCE_RECEIPTS", "FINANCE_RECEIPT_ORDERS");
    // 其他收款权限（用于显示收款管理下的其他收款菜单，父级收款管理权限可继承显示）。
    var canViewFinanceOtherReceipts = HasPermission("FINANCE", "FINANCE_RECEIPTS", "FINANCE_OTHER_RECEIPTS");
    // 收款管理权限（用于显示财务管理下的收款管理父级菜单）。
