@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error_Title"];
}

<h1 class="text-danger">@Localizer["Error_Heading"]</h1>
<h2 class="text-danger">@Localizer["Error_Message"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["Error_DevelopmentMode"]</h3>
<p>@Localizer["Error_DevelopmentModeDescription"]</p>
<p>
    <strong>@Localizer["Error_DevelopmentModeWarning"]</strong>
    @Localizer["Error_DevelopmentModeInstruction"]
</p>
