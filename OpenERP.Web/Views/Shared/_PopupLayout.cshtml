@using System.Globalization
@using System.Security.Claims
@inject OpenERP.Web.Printing.ICompanyPrintTemplateService CompanyPrintTemplateService
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var currentCompanyValue = User.FindFirst("erp:company")?.Value;
    var currentCompanyPrintSettings = await CompanyPrintTemplateService.GetSettingsByOrganizationCodeAsync(currentCompanyValue);
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"] - Open ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpenERP.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="popup-layout-body">
    @await Html.PartialAsync("_CompanyPrintChrome", currentCompanyPrintSettings)
    <main class="popup-layout-shell company-print-page">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
