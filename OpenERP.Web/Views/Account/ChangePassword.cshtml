@using OpenERP.Web.Controllers
@model ChangePasswordViewModel

@{
    ViewData["Title"] = "修改密码";
    var successMessage = TempData["ChangePasswordSuccessMessage"]?.ToString();
}

@section Styles {
    <style>
        .change-password-page {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 1rem 0 2rem;
        }

        .change-password-card {
            width: min(560px, 100%);
            border: 1px solid #d8e3ee;
            border-radius: 8px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            box-shadow: 0 18px 42px rgba(15, 36, 64, 0.08);
        }

        .change-password-card__header {
            padding: 1.2rem 1.35rem 1rem;
            border-bottom: 1px solid #e0e9f2;
        }

        .change-password-card__title {
            margin: 0;
            color: #163454;
            font-size: 1.25rem;
            font-weight: 800;
        }

        .change-password-card__subtitle {
            margin-top: 0.4rem;
            color: #6a7f95;
            font-size: 0.9rem;
        }

        .change-password-card__body {
            padding: 1.35rem;
        }

        .change-password-form__row + .change-password-form__row {
            margin-top: 1rem;
        }

        .change-password-form__label {
            display: block;
            margin-bottom: 0.45rem;
            color: #163454;
            font-weight: 700;
        }

        .change-password-form__field {
            position: relative;
        }

        .change-password-form__input {
            height: 42px;
            padding-right: 2.8rem;
            border-radius: 8px;
            border: 1px solid #c6d5e3;
        }

        .change-password-form__toggle {
            position: absolute;
            top: 50%;
            right: 0.35rem;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #60778f;
        }

        .change-password-form__toggle:hover {
            background: #edf4fb;
            color: #163454;
        }

        .change-password-form__actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            margin-top: 1.4rem;
        }
    </style>
}

<section class="change-password-page">
    <div class="change-password-card">
        <div class="change-password-card__header">
            <h1 class="change-password-card__title">修改密码</h1>
            <div class="change-password-card__subtitle">请输入当前密码，并设置新的登录密码。</div>
        </div>
        <div class="change-password-card__body">
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success" role="alert">@successMessage</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
            }

            <form asp-action="ChangePassword" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="change-password-form__row">
                    <label asp-for="CurrentPassword" class="change-password-form__label"></label>
                    <div class="change-password-form__field">
                        <input asp-for="CurrentPassword" class="form-control change-password-form__input js-password-field" autocomplete="current-password" />
                        <button type="button" class="change-password-form__toggle js-password-toggle" aria-label="显示密码">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="change-password-form__row">
                    <label asp-for="NewPassword" class="change-password-form__label"></label>
                    <div class="change-password-form__field">
                        <input asp-for="NewPassword" class="form-control change-password-form__input js-password-field" autocomplete="new-password" />
                        <button type="button" class="change-password-form__toggle js-password-toggle" aria-label="显示密码">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="change-password-form__row">
                    <label asp-for="ConfirmPassword" class="change-password-form__label"></label>
                    <div class="change-password-form__field">
                        <input asp-for="ConfirmPassword" class="form-control change-password-form__input js-password-field" autocomplete="new-password" />
                        <button type="button" class="change-password-form__toggle js-password-toggle" aria-label="显示密码">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="change-password-form__actions">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">返回</a>
                    <button type="submit" class="btn btn-primary">保存新密码</button>
                </div>
            </form>
        </div>
    </div>
</section>

<partial name="_ValidationScriptsPartial" />

<script>
    (() => {
        const passwordToggleButtons = document.querySelectorAll(".js-password-toggle");

        passwordToggleButtons.forEach(toggleButton => {
            toggleButton.addEventListener("click", () => {
                const fieldShell = toggleButton.closest(".change-password-form__field");
                const passwordInput = fieldShell?.querySelector(".js-password-field");
                if (!(passwordInput instanceof HTMLInputElement)) {
                    return;
                }

                const isVisible = passwordInput.type === "text";
                passwordInput.type = isVisible ? "password" : "text";
                toggleButton.setAttribute("aria-label", isVisible ? "显示密码" : "隐藏密码");
                toggleButton.innerHTML = isVisible
                    ? '<i class="bi bi-eye" aria-hidden="true"></i>'
                    : '<i class="bi bi-eye-slash" aria-hidden="true"></i>';
            });
        });
    })();
</script>
