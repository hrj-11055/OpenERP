@using System.Globalization
@using OpenERP.Web.Controllers
@model LoginViewModel

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var defaultCompanyHint = "输入登录账号后，系统会自动过滤可登录的公司组织。";
    var companyScopeHint = string.IsNullOrWhiteSpace(Model.CompanyScopeHint) ? defaultCompanyHint : Model.CompanyScopeHint;
    ViewData["Title"] = Localizer["Login_Title"];
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;800&family=ZCOOL+QingKe+HuangYou&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-scene">
        <div class="bg-layer"></div>
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="blob b3"></div>
        <div class="noise"></div>

        <div class="scene-watermark">@Localizer["Login_Watermark"]</div>

        <div class="top-actions">
            <form asp-controller="Home" asp-action="SetLanguage" method="post" class="lang-switch notranslate" translate="no">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label for="culture" class="visually-hidden">@Localizer["Layout_Language"]</label>
                <select id="culture" name="culture" aria-label="@Localizer["Layout_Language"]" onchange="this.form.submit()" translate="no">
                    <option value="zh-Hans" selected="@(currentCulture == "zh-Hans")">@Localizer["Language_SimplifiedChinese"]</option>
                    <option value="zh-Hant" selected="@(currentCulture == "zh-Hant")">@Localizer["Language_TraditionalChinese"]</option>
                    <option value="en" selected="@(currentCulture == "en")">@Localizer["Language_English"]</option>
                </select>
            </form>
        </div>

        <section class="login-shell" aria-label="@Localizer["Login_PageAria"]">
            <aside class="brand-side">
                <h1>@Localizer["Login_CompanyName"]</h1>
                <div class="brand-logo" aria-hidden="true">
                    <span>f</span>
                </div>
            </aside>

            <div class="form-side">
                <form asp-action="Login"
                      asp-controller="Account"
                      method="post"
                      class="login-form"
                      id="loginForm"
                      data-company-options-url="@Url.Action("CompanyOptions", "Account")"
                      novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="login-alert" asp-validation-summary="ModelOnly"></div>
                    }

                    <div class="field">
                        <label class="visually-hidden" asp-for="FiscalYear">@Html.DisplayNameFor(m => m.FiscalYear)</label>
                        <div class="field-shell">
                            <i class="bi bi-calendar2-week field-icon" aria-hidden="true"></i>
                            <select asp-for="FiscalYear" class="field-control field-select">
                                @foreach (var option in Model.FiscalYearOptions)
                                {
                                    <option value="@option.Value" selected="@option.IsSelected">@option.Text</option>
                                }
                            </select>
                            <i class="bi bi-chevron-down field-arrow" aria-hidden="true"></i>
                        </div>
                        <span asp-validation-for="FiscalYear" class="field-validation"></span>
                    </div>

                    <div class="field">
                        <label class="visually-hidden" asp-for="Company">@Html.DisplayNameFor(m => m.Company)</label>
                        <div class="field-shell">
                            <i class="bi bi-bank field-icon" aria-hidden="true"></i>
                            <select asp-for="Company" class="field-control field-select" disabled="@(Model.CompanyOptions.Count == 0)">
                                @foreach (var option in Model.CompanyOptions)
                                {
                                    <option value="@option.Value" selected="@option.IsSelected">@option.Text</option>
                                }
                            </select>
                            <i class="bi bi-chevron-down field-arrow" aria-hidden="true"></i>
                        </div>
                        <div class="field-note @(Model.CompanyOptions.Count == 0 ? "is-restricted" : string.Empty)"
                             id="companyScopeHint"
                             data-default-text="@defaultCompanyHint"
                             aria-live="polite">
                            @companyScopeHint
                        </div>
                        <span asp-validation-for="Company" class="field-validation"></span>
                    </div>

                    <div class="field">
                        <label class="visually-hidden" asp-for="Account">@Html.DisplayNameFor(m => m.Account)</label>
                        <div class="field-shell">
                            <i class="bi bi-person-fill field-icon" aria-hidden="true"></i>
                            <input asp-for="Account" class="field-control" placeholder="@Localizer["Login_AccountPlaceholder"]" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Account" class="field-validation"></span>
                    </div>

                    <div class="field">
                        <label class="visually-hidden" asp-for="Password">@Html.DisplayNameFor(m => m.Password)</label>
                        <div class="field-shell">
                            <i class="bi bi-lock-fill field-icon" aria-hidden="true"></i>
                            <input asp-for="Password" class="field-control field-control--password" placeholder="@Localizer["Login_PasswordPlaceholder"]" autocomplete="current-password" />
                            <button type="button"
                                    class="field-toggle"
                                    id="passwordToggleButton"
                                    aria-label="显示密码"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation"></span>
                    </div>

                    <button type="submit" class="submit-btn" id="loginSubmitButton">@Localizer["Login_Submit"]</button>

                    <a class="forgot-link" href="javascript:void(0)">@Localizer["Login_ForgotPassword"]</a>
                </form>
            </div>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const loginForm = document.getElementById("loginForm");
            const loginSubmitButton = document.getElementById("loginSubmitButton");
            const passwordInput = document.getElementById("Password");
            const passwordToggleButton = document.getElementById("passwordToggleButton");
            const accountInput = document.getElementById("Account");
            const companySelect = document.getElementById("Company");
            const companyScopeHint = document.getElementById("companyScopeHint");
            const companyOptionsUrl = loginForm?.dataset.companyOptionsUrl || "";
            const defaultCompanyHint = companyScopeHint?.dataset.defaultText || "";
            const showPasswordLabel = "显示密码";
            const hidePasswordLabel = "隐藏密码";
            let companyLookupTimer = 0;
            let companyRequestSequence = 0;

            if (!loginForm || !loginSubmitButton) {
                return;
            }

            const updateCompanyHint = (message, state = "") => {
                if (!(companyScopeHint instanceof HTMLElement)) {
                    return;
                }

                companyScopeHint.textContent = message || defaultCompanyHint;
                companyScopeHint.classList.toggle("is-loading", state === "loading");
                companyScopeHint.classList.toggle("is-restricted", state === "restricted");
                companyScopeHint.classList.toggle("is-error", state === "error");
            };

            const renderCompanyOptions = (payload) => {
                if (!(companySelect instanceof HTMLSelectElement)) {
                    return;
                }

                const companies = Array.isArray(payload?.companies) ? payload.companies : [];
                companySelect.innerHTML = "";

                if (companies.length === 0) {
                    const option = document.createElement("option");
                    option.value = "";
                    option.textContent = "暂无可登录公司";
                    companySelect.appendChild(option);
                    companySelect.disabled = true;
                } else {
                    companies.forEach(company => {
                        const option = document.createElement("option");
                        option.value = company.value || "";
                        option.textContent = company.text || company.value || "";
                        option.selected = Boolean(company.isSelected);
                        companySelect.appendChild(option);
                    });

                    if (![...companySelect.options].some(option => option.selected) && companySelect.options.length > 0) {
                        companySelect.options[0].selected = true;
                    }

                    companySelect.disabled = false;
                }

                updateCompanyHint(
                    payload?.hintMessage || defaultCompanyHint,
                    payload?.isRestricted
                        ? "restricted"
                        : (companies.length === 0 ? "error" : ""));
            };

            const loadCompanyOptions = async () => {
                if (!(accountInput instanceof HTMLInputElement)
                    || !(companySelect instanceof HTMLSelectElement)
                    || !companyOptionsUrl) {
                    return;
                }

                const account = accountInput.value.trim();
                const selectedCompany = companySelect.value;
                const requestId = ++companyRequestSequence;
                const requestUrl = new URL(companyOptionsUrl, window.location.origin);

                if (account.length > 0) {
                    requestUrl.searchParams.set("account", account);
                    updateCompanyHint("正在匹配可登录公司...", "loading");
                } else {
                    updateCompanyHint(defaultCompanyHint);
                }

                if (selectedCompany.length > 0) {
                    requestUrl.searchParams.set("selectedCompany", selectedCompany);
                }

                try {
                    const response = await fetch(requestUrl.toString(), {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    if (requestId !== companyRequestSequence) {
                        return;
                    }

                    if (!response.ok) {
                        throw new Error("Failed to load company options.");
                    }

                    renderCompanyOptions(await response.json());
                } catch {
                    if (requestId !== companyRequestSequence) {
                        return;
                    }

                    companySelect.disabled = false;
                    updateCompanyHint("加载可登录公司失败，请稍后重试。", "error");
                }
            };

            const queueCompanyLookup = () => {
                window.clearTimeout(companyLookupTimer);
                companyLookupTimer = window.setTimeout(() => {
                    void loadCompanyOptions();
                }, 280);
            };

            if (passwordInput instanceof HTMLInputElement && passwordToggleButton instanceof HTMLButtonElement) {
                passwordToggleButton.addEventListener("click", () => {
                    const isPasswordVisible = passwordInput.type === "text";
                    passwordInput.type = isPasswordVisible ? "password" : "text";
                    passwordToggleButton.setAttribute("aria-pressed", String(!isPasswordVisible).toLowerCase());
                    passwordToggleButton.setAttribute("aria-label", isPasswordVisible ? showPasswordLabel : hidePasswordLabel);
                    passwordToggleButton.innerHTML = isPasswordVisible
                        ? '<i class="bi bi-eye" aria-hidden="true"></i>'
                        : '<i class="bi bi-eye-slash" aria-hidden="true"></i>';
                });
            }

            if (accountInput instanceof HTMLInputElement) {
                accountInput.addEventListener("input", queueCompanyLookup);
                accountInput.addEventListener("blur", () => {
                    window.clearTimeout(companyLookupTimer);
                    void loadCompanyOptions();
                });
            }

            loginForm.addEventListener("keydown", event => {
                if (event.key !== "Enter" || event.isComposing) {
                    return;
                }

                const target = event.target;
                if (!(target instanceof HTMLElement)) {
                    return;
                }

                if (target.tagName === "BUTTON" || target.tagName === "TEXTAREA") {
                    return;
                }

                event.preventDefault();
                loginSubmitButton.click();
            });

            void loadCompanyOptions();
        })();
    </script>
</body>
</html>
