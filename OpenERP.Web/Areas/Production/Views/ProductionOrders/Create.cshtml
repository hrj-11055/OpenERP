@model OpenERP.Production.Models.Entities.ProductionOrder
@{
    ViewData["Title"] = "新建生产订单";
}

<div class="container">
    <h1 class="mt-4">新建生产订单</h1>
    <form asp-area="Production" asp-controller="ProductionOrders" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="OrderNumber" class="form-label">订单编号</label>
            <input asp-for="OrderNumber" class="form-control" placeholder="保存时按当前公司规则自动生成" readonly />
            <span asp-validation-for="OrderNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ProductName" class="form-label">物料/产品名称</label>
            <input asp-for="ProductName" class="form-control" required />
            <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PlannedQuantity" class="form-label">计划生产数量</label>
            <input asp-for="PlannedQuantity" class="form-control" type="number" step="0.01" required />
            <span asp-validation-for="PlannedQuantity" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="StartDate" class="form-label">计划开始日期</label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="EndDate" class="form-label">计划结束日期</label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-area="Production" asp-controller="ProductionOrders" asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
