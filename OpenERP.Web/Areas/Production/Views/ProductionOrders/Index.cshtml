@model IEnumerable<OpenERP.Production.Models.Entities.ProductionOrder>
@{
    ViewData["Title"] = "生产订单管理";
}

<div class="container-fluid">
    <h1 class="mt-4">生产订单管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">生产订单管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-gear-wide-connected me-1"></i>
                生产订单列表
            </div>
            <a asp-area="Production" asp-controller="ProductionOrders" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新建订单
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>订单编号</th>
                        <th>物料/产品</th>
                        <th>计划生产数量</th>
                        <th>状态</th>
                        <th>计划开始日期</th>
                        <th>计划结束日期</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="6" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderNumber</td>
                            <td>@item.ProductName</td>
                            <td>@item.PlannedQuantity</td>
                            <td>@item.Status</td>
                            <td>@item.StartDate?.ToShortDateString()</td>
                            <td>@item.EndDate?.ToShortDateString()</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
