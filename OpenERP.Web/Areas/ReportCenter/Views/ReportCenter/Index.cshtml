@{
    var featureName = ViewData["FeatureName"]?.ToString() ?? "报表中心";
    var featureDescription = ViewData["FeatureDescription"]?.ToString() ?? "用于维护报表中心相关业务资料。";
}

<div class="container-fluid erp-card-page">
    <h1 class="erp-card-page__title">@featureName</h1>
    <ol class="breadcrumb erp-card-page__breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item">报表中心</li>
        <li class="breadcrumb-item active">@featureName</li>
    </ol>

    <div class="row erp-card-page__sections">
        <div class="col-xl-8">
            <section class="erp-content-card">
                <div class="erp-content-card__header">
                    <span><i class="bi bi-bar-chart-line me-2"></i>@featureName</span>
                </div>
                <div class="erp-content-card__body">
                    <p class="mb-2">@featureDescription</p>
                    <p class="text-muted mb-0">当前已完成报表菜单入口，后续可在此扩展查询条件、图表展示、明细穿透、导出和权限控制能力。</p>
                </div>
            </section>
        </div>
    </div>
</div>
