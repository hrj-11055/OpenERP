@model OpenERP.Transport.Models.Entities.TransportRequest
@{
    ViewData["Title"] = "新建运输请求";
}

<div class="container">
    <h1 class="mt-4">新建运输请求</h1>
    <form asp-area="Transport" asp-controller="TransportRequests" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">标题</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">描述</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Status" class="form-label">状态</label>
            <select asp-for="Status" class="form-select">
                <option value="Pending">待处理</option>
                <option value="In-Transit">运输中</option>
                <option value="Delivered">已送达</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="VehicleId" class="form-label">车辆</label>
            <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId">
                <option value="">请选择</option>
            </select>
            <span asp-validation-for="VehicleId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-area="Transport" asp-controller="TransportRequests" asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
