@model OpenERP.Transport.Models.Entities.Vehicle
@{
    ViewData["Title"] = "新增车辆";
}

<div class="container">
    <h1 class="mt-4">新增车辆</h1>
    <form asp-area="Transport" asp-controller="Vehicles" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">名称</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LicensePlate" class="form-label">车牌号</label>
            <input asp-for="LicensePlate" class="form-control" />
            <span asp-validation-for="LicensePlate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Type" class="form-label">类型</label>
            <input asp-for="Type" class="form-control" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Capacity" class="form-label">容量</label>
            <input asp-for="Capacity" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-area="Transport" asp-controller="Vehicles" asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
