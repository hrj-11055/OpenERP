@model IEnumerable<OpenERP.Transport.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "车辆管理";
}

<div class="container-fluid">
    <h1 class="mt-4">车辆管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">车辆管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-truck me-1"></i>
                车辆列表
            </div>
            <a asp-area="Transport" asp-controller="Vehicles" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新增车辆
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>车牌号</th>
                        <th>类型</th>
                        <th>容量</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="5" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.LicensePlate</td>
                            <td>@item.Type</td>
                            <td>@item.Capacity</td>
                            <td>
                                <a asp-area="Transport" asp-controller="Vehicles" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">编辑</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
