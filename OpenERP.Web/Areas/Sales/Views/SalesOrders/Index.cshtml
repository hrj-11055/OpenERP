@model IEnumerable<OpenERP.Sales.Models.Entities.SalesOrder>
@{
    ViewData["Title"] = "销售单管理";
}
<div class="container-fluid">
    <h1 class="mt-4">销售单管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">销售单管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-receipt me-1"></i>
                销售单列表
            </div>
            <a asp-area="Sales" asp-controller="SalesOrders" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新建销售单
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>单号</th>
                        <th>日期</th>
                        <th>客户</th>
                        <th>状态</th>
                        <th>总额</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderNumber</td>
                            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Customer?.Name</td>
                            <td>@item.Status</td>
                            <td>@item.TotalAmount.ToString("F2")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
