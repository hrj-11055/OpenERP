@model IEnumerable<OpenERP.Service.Models.Entities.ServiceRequest>
@{
    ViewData["Title"] = "服务请求管理";
}

<div class="container-fluid">
    <h1 class="mt-4">服务请求管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">服务请求管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-tools me-1"></i>
                服务请求列表
            </div>
            <a asp-area="Service" asp-controller="ServiceRequests" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新建请求
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>标题</th>
                        <th>描述</th>
                        <th>状态</th>
                        <th>合同</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="5" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td>@item.Status</td>
                            <td>@item.ServiceContract?.Name</td>
                            <td>
                                <a asp-area="Service" asp-controller="ServiceRequests" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">编辑</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
