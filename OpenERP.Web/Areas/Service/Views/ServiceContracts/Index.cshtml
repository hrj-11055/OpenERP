@model IEnumerable<OpenERP.Service.Models.Entities.ServiceContract>
@{
    ViewData["Title"] = "服务合同管理";
}

<div class="container-fluid">
    <h1 class="mt-4">服务合同管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">服务合同管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-journal-check me-1"></i>
                服务合同列表
            </div>
            <a asp-area="Service" asp-controller="ServiceContracts" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新增合同
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>客户名称</th>
                        <th>开始日期</th>
                        <th>结束日期</th>
                        <th>状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="6" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.CustomerName</td>
                            <td>@item.StartDate.ToShortDateString()</td>
                            <td>@item.EndDate.ToShortDateString()</td>
                            <td>@item.Status</td>
                            <td>
                                <a asp-area="Service" asp-controller="ServiceContracts" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">编辑</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
