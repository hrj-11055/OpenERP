@model OpenERP.CRM.Models.Entities.Opportunity
@{
    ViewData["Title"] = "编辑销售机会";
}

<div class="container">
    <h1 class="mt-4">编辑销售机会</h1>
    <form asp-area="CRM" asp-controller="Opportunities" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">名称</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AccountName" class="form-label">客户名称</label>
            <input asp-for="AccountName" class="form-control" />
            <span asp-validation-for="AccountName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Stage" class="form-label">阶段</label>
            <select asp-for="Stage" class="form-select">
                <option value="Prospecting">初步接触</option>
                <option value="Qualification">资格认定</option>
                <option value="Proposal">方案提交</option>
                <option value="Negotiation">谈判</option>
                <option value="Closed Won">已成交</option>
                <option value="Closed Lost">已丢失</option>
            </select>
            <span asp-validation-for="Stage" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label">金额</label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-area="CRM" asp-controller="Opportunities" asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
