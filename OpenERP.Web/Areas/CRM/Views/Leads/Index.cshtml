@model IEnumerable<OpenERP.CRM.Models.Entities.Lead>
@{
    ViewData["Title"] = "销售线索管理";
}

<div class="container-fluid">
    <h1 class="mt-4">销售线索管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">销售线索管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-person-lines-fill me-1"></i>
                销售线索列表
            </div>
            <a asp-area="CRM" asp-controller="Leads" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新增线索
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>公司</th>
                        <th>邮箱</th>
                        <th>电话</th>
                        <th>状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="6" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Company</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@item.Status</td>
                            <td>
                                <a asp-area="CRM" asp-controller="Leads" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">编辑</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
