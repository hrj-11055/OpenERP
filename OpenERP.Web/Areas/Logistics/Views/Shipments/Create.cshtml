@model OpenERP.Logistics.Models.Entities.Shipment
@{
    ViewData["Title"] = "新建物流单";
}
<div class="container">
    <h2 class="mt-4">新建物流单</h2>
    <form asp-area="Logistics" asp-controller="Shipments" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="ShipmentNumber" class="form-label"></label>
            <input asp-for="ShipmentNumber" class="form-control" />
            <span asp-validation-for="ShipmentNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ShipmentDate" class="form-label"></label>
            <input asp-for="ShipmentDate" class="form-control" type="date" />
        </div>
        <div class="mb-3">
            <label asp-for="CarrierId" class="form-label">承运商</label>
            <select asp-for="CarrierId" asp-items="ViewBag.CarrierId" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label asp-for="TotalWeight" class="form-label"></label>
            <input asp-for="TotalWeight" class="form-control" type="number" step="0.01" />
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-area="Logistics" asp-controller="Shipments" asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
