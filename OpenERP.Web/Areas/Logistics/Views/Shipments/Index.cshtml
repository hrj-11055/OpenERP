@model IEnumerable<OpenERP.Logistics.Models.Entities.Shipment>
@{
    ViewData["Title"] = "物流单管理";
}
<div class="container-fluid">
    <h1 class="mt-4">物流单管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首页</a></li>
        <li class="breadcrumb-item active">物流单管理</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-box-seam me-1"></i>
                物流单列表
            </div>
            <a asp-area="Logistics" asp-controller="Shipments" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> 新建物流单
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>单号</th>
                        <th>日期</th>
                        <th>承运商</th>
                        <th>状态</th>
                        <th>总重量</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center">暂无数据</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ShipmentNumber</td>
                            <td>@item.ShipmentDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Carrier?.Name</td>
                            <td>@item.Status</td>
                            <td>@item.TotalWeight.ToString("F2")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
