@model OpenERP.Web.Areas.Logistics.ViewModels.MaterialItems.MaterialItemEditViewModel

<div class="material-grid-panel">
    <div class="training-experience-toolbar">
        <div class="training-experience-toolbar__filters">
            <select class="form-select"><option>全部</option><option>物料编号</option><option>物料名称</option></select>
            <input type="text" class="form-control" placeholder="请输入关键字查询" />
            <button type="button" class="employee-detail-toolbar__btn">查询</button>
            <button type="button" class="employee-detail-toolbar__btn">刷新</button>
        </div>
        <div class="training-experience-toolbar__actions">
            <button id="addBomLineButton" type="button" class="employee-detail-toolbar__btn">新增</button>
            <button id="deleteBomLineButton" type="button" class="employee-detail-toolbar__btn">删除</button>
        </div>
    </div>
    <div class="training-experience-table-shell">
        <table id="materialBomTable" class="training-experience-table material-edit-table">
            <thead>
                <tr>
                    <th>序号</th>
                    <th class="training-experience-table__checkbox"></th>
                    <th>物料编号</th>
                    <th>物料名称</th>
                    <th>物料描述</th>
                    <th>用量</th>
                    <th>损耗率(%)</th>
                    <th>用量及损耗</th>
                    <th>单位</th>
                    <th>成本单价</th>
                    <th>成本金额</th>
                    <th>备注</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.BomLines.Count; i++)
                {
                    <tr data-bom-row>
                        <td class="bom-sequence training-experience-table__seq">@(i + 1)</td>
                        <td class="training-experience-table__checkbox"><input type="checkbox" class="bom-row-selector" aria-label="选择BOM行 @(i + 1)" /></td>
                        <td>
                            <input asp-for="BomLines[i].Id" type="hidden" />
                            <input asp-for="BomLines[i].IsDeleted" type="hidden" class="bom-delete-flag" />
                            <input asp-for="BomLines[i].ComponentCode" class="form-control material-table-input" />
                        </td>
                        <td><input asp-for="BomLines[i].ComponentName" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].ComponentDescription" class="form-control material-table-input material-table-input--wide" /></td>
                        <td><input asp-for="BomLines[i].Quantity" type="number" step="0.0001" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].LossRatePercent" type="number" step="0.0001" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].QuantityWithLoss" type="number" step="0.0001" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].Unit" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].CostPrice" type="number" step="0.0001" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].CostAmount" type="number" step="0.0001" class="form-control material-table-input" /></td>
                        <td><input asp-for="BomLines[i].Remarks" class="form-control material-table-input material-table-input--wide" /></td>
                        <td><button type="button" class="training-experience-archive-btn material-row-action" data-remove-bom>删除</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <template id="materialBomRowTemplate">
        <tr data-bom-row>
            <td class="bom-sequence training-experience-table__seq"></td>
            <td class="training-experience-table__checkbox"><input type="checkbox" class="bom-row-selector" aria-label="选择BOM行" /></td>
            <td>
                <input name="BomLines[__index__].Id" type="hidden" />
                <input name="BomLines[__index__].IsDeleted" type="hidden" value="false" class="bom-delete-flag" />
                <input name="BomLines[__index__].ComponentCode" class="form-control material-table-input" />
            </td>
            <td><input name="BomLines[__index__].ComponentName" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].ComponentDescription" class="form-control material-table-input material-table-input--wide" /></td>
            <td><input name="BomLines[__index__].Quantity" type="number" step="0.0001" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].LossRatePercent" type="number" step="0.0001" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].QuantityWithLoss" type="number" step="0.0001" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].Unit" value="部" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].CostPrice" type="number" step="0.0001" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].CostAmount" type="number" step="0.0001" class="form-control material-table-input" /></td>
            <td><input name="BomLines[__index__].Remarks" class="form-control material-table-input material-table-input--wide" /></td>
            <td><button type="button" class="training-experience-archive-btn material-row-action" data-remove-bom>删除</button></td>
        </tr>
    </template>
</div>
