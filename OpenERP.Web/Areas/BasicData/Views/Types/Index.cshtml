@model IEnumerable<OpenERP.BasicData.Models.BasicDataType>

@{
    ViewData["Title"] = "基础数据类型";
}

<div class="container-fluid">
    <h1 class="mt-4">基础数据类型</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">控制面板</a></li>
        <li class="breadcrumb-item"><a asp-area="BasicData" asp-controller="Home" asp-action="Index">基础数据模块</a></li>
        <li class="breadcrumb-item active">类型管理</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-1"></i> 基础数据类型</span>
            <div class="d-flex gap-2">
                <a asp-area="BasicData" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">模块首页</a>
                <a asp-area="BasicData" asp-controller="Items" asp-action="Index" class="btn btn-outline-primary btn-sm">选项管理</a>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> 新增类型
                </a>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>类型编码</th>
                        <th>类型名称</th>
                        <th>说明</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center">暂无数据</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TypeCode</td>
                                <td>@item.TypeName</td>
                                <td>@item.Description</td>
                                <td>
                                    <a asp-area="BasicData" asp-controller="Items" asp-action="Index" asp-route-typeId="@item.Id" class="btn btn-secondary btn-sm">查看选项</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">编辑</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">删除</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

