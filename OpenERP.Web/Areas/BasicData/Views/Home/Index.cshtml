@model IEnumerable<OpenERP.Web.Areas.BasicData.Models.BasicDataModuleEntry>

@{
    ViewData["Title"] = "鍩虹鏁版嵁妯″潡";
}

<div class="container-fluid">
    <h1 class="mt-4">鍩虹鏁版嵁妯″潡</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">鎺у埗闈㈡澘</a></li>
        <li class="breadcrumb-item active">鍩虹鏁版嵁妯″潡</li>
    </ol>

    @if (TempData["BasicDataMessage"] is string message)
    {
        <div class="alert alert-warning" role="alert">@message</div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-grid-1x2-fill me-1"></i> 甯哥敤鍩虹鏁版嵁椤圭洰</span>
            <div class="d-flex gap-2">
                <a asp-area="BasicData" asp-controller="Types" asp-action="Index" class="btn btn-outline-primary btn-sm">绫诲瀷绠＄悊</a>
                <a asp-area="BasicData" asp-controller="Items" asp-action="Index" class="btn btn-outline-secondary btn-sm">閫夐」绠＄悊</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-xl-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="@item.IconCss fs-4 me-2 text-primary"></i>
                                    <h5 class="mb-0">@item.DisplayName</h5>
                                </div>
                                <p class="text-muted small mb-3">@item.Description</p>
                                <div class="mt-auto">
                                    @if (item.TypeId.HasValue)
                                    {
                                        <a asp-area="BasicData" asp-controller="Items" asp-action="Index" asp-route-typeId="@item.TypeId" class="btn btn-primary btn-sm">
                                            杩涘叆绠＄悊
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="BasicData" asp-controller="Home" asp-action="Open" asp-route-typeCode="@item.TypeCode" class="btn btn-outline-warning btn-sm">
                                            鍒濆鍖栧悗杩涘叆
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer text-muted small">
            褰撳墠鍩虹鏁版嵁绫诲瀷鎬绘暟锛欯ViewData["TotalTypeCount"]
        </div>
    </div>
</div>


