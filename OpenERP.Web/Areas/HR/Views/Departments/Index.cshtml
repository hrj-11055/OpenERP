@model IEnumerable<OpenERP.HR.Models.Entities.Department>

@{
    ViewData["Title"] = Localizer["Layout_DepartmentManagement"];
}

<div class="container-fluid">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-table me-1"></i>
                @Localizer["Department_List"]
            </div>
            <a asp-area="HR" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> @Localizer["Department_CreateTitle"]
            </a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@Localizer["Department_Name"]</th>
                        <th>@Localizer["Common_Description"]</th>
                        <th>@Localizer["Common_CreatedAt"]</th>
                        <th>@Localizer["Common_Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center">@Localizer["Department_NoRecords"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a href="#" class="btn btn-info btn-sm">@Localizer["Common_Edit"]</a>
                                    <a href="#" class="btn btn-danger btn-sm">@Localizer["Common_Delete"]</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
