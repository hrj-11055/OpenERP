@model OpenERP.HR.Models.Entities.Employee
@{
    ViewData["Title"] = Localizer["Delete_PageTitle"];

    var isPopup = ViewBag.IsPopup as bool? == true;
    Layout = isPopup ? "~/Views/Shared/_PopupLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";

    var displayName = string.IsNullOrWhiteSpace(Model.LastName) && string.IsNullOrWhiteSpace(Model.FirstName)
        ? Localizer["Delete_Unnamed"].Value
        : $"{Model.LastName ?? ""}{Model.FirstName ?? ""}";
}

<div class="employee-delete-page">
    <form asp-area="HR" asp-controller="Employees" asp-action="Delete" method="post" class="employee-delete-shell">
        <input type="hidden" name="popup" value="@isPopup.ToString().ToLowerInvariant()" />
        <input type="hidden" asp-for="Id" />

        <div class="employee-delete-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <h4 class="employee-delete-title">@Localizer["Delete_ConfirmTitle"]</h4>

        <div class="employee-delete-info">
            <span class="employee-delete-label">@Localizer["Delete_EmployeeCode"]：</span>
            <span class="employee-delete-value">@Model.EmployeeCode</span>
        </div>
        <div class="employee-delete-info">
            <span class="employee-delete-label">@Localizer["Delete_EmployeeName"]：</span>
            <span class="employee-delete-value">@displayName</span>
        </div>

        <p class="employee-delete-warning">
            @Localizer["Delete_WarningText"]
        </p>

        <div class="employee-delete-actions">
            <button type="submit" class="employee-delete-actions__btn employee-delete-actions__btn--danger">@Localizer["Delete_ConfirmButton"]</button>
            <button type="button" class="employee-delete-actions__btn" onclick="window.closeEmployeeDetailPage()">@Localizer["Delete_CancelButton"]</button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .employee-delete-page {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 48px);
        }

        .employee-delete-shell {
            width: 100%;
            max-width: 420px;
            padding: 2rem 1.5rem;
            border: 1px solid #b9c7d6;
            background: #fff;
            box-shadow: 0 14px 32px rgba(40, 60, 84, 0.12);
            text-align: center;
        }

        .employee-delete-icon {
            margin-bottom: 1rem;
            font-size: 2.5rem;
            color: #d97706;
        }

        .employee-delete-title {
            margin: 0 0 1rem;
            color: #1f2b39;
            font-size: 1.1rem;
        }

        .employee-delete-info {
            display: flex;
            justify-content: center;
            gap: 0.25rem;
            margin-bottom: 0.35rem;
            font-size: 0.9rem;
        }

        .employee-delete-label {
            color: #6b7280;
        }

        .employee-delete-value {
            color: #1f2b39;
            font-weight: 600;
        }

        .employee-delete-warning {
            margin: 1.2rem 0 1.5rem;
            color: #dc2626;
            font-size: 0.88rem;
        }

        .employee-delete-actions {
            display: flex;
            gap: 0.75rem;
            justify-content: center;
        }

        .employee-delete-actions__btn {
            min-width: 100px;
            border: 1px solid #b9c7d6;
            border-radius: 4px;
            padding: 0.4rem 1.2rem;
            background: linear-gradient(180deg, #ffffff 0%, #eef1f5 100%);
            color: #111827;
            font-size: 0.88rem;
            cursor: pointer;
        }

        .employee-delete-actions__btn--danger {
            border-color: #dc2626;
            background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
            color: #fff;
        }

        .employee-delete-actions__btn:hover {
            opacity: 0.85;
        }
    </style>
}
