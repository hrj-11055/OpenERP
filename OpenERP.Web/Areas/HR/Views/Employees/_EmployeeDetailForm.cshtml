@model OpenERP.HR.Models.Entities.Employee
@{
    var isPopup = ViewBag.IsPopup as bool? == true;
    var isEdit = Model?.Id > 0;
    var formAction = ViewData["FormAction"]?.ToString() ?? (isEdit ? "Edit" : "Create");
    var saveButtonText = ViewData["SaveButtonText"]?.ToString() ?? Localizer["Common_Save"].Value;
    var isLeaveStatus = Model?.LeaveDate.HasValue == true;
    var detailStatus = isLeaveStatus ? Localizer["Employee_Status_Left"].Value : Localizer["Employee_Status_Active"].Value;
    var isReadOnly = ViewData["IsReadOnly"] as bool? == true;
    var ro = isReadOnly ? "readonly" : null;
    var dis = isReadOnly ? "disabled" : null;
    var createUrl = Url.Action("Create", "Employees", new { area = "HR", popup = isPopup }) ?? "#";
    var positionManagerUrl = Url.Action("Index", "Items", new { area = "BasicData", typeCode = "POSITION", popup = true }) ?? "#";
    var ethnicityManagerUrl = Url.Action("Index", "Items", new { area = "BasicData", typeCode = "ETHNICITY", popup = true }) ?? "#";
    var professionalTitleManagerUrl = Url.Action("Index", "Items", new { area = "BasicData", typeCode = "PROFESSIONAL_TITLE", popup = true }) ?? "#";
    var allowancePackageManagerUrl = Url.Action("Index", "Items", new { area = "BasicData", typeCode = "ALLOWANCE_PACKAGE", popup = true }) ?? "#";
    var schedulingGroupManagerUrl = Url.Action("Index", "Items", new { area = "BasicData", typeCode = "SCHEDULING_GROUP", popup = true }) ?? "#";
    var bankManagerUrl = Url.Action("Index", "Items", new { area = "BasicData", typeCode = "BANK", popup = true }) ?? "#";
    var positionOptionsUrl = Url.Action("Options", "CustomOptions", new { source = "position" }) ?? "#";
    var ethnicityOptionsUrl = Url.Action("Options", "CustomOptions", new { source = "ethnicity" }) ?? "#";
    var professionalTitleOptionsUrl = Url.Action("Options", "CustomOptions", new { source = "professional-title" }) ?? "#";
    var allowancePackageOptionsUrl = Url.Action("Options", "CustomOptions", new { source = "allowance-package" }) ?? "#";
    var schedulingGroupOptionsUrl = Url.Action("Options", "CustomOptions", new { source = "scheduling-group" }) ?? "#";
    var bankOptionsUrl = Url.Action("Options", "CustomOptions", new { source = "bank" }) ?? "#";
    var locationOptionsUrl = Url.Action("LocationOptions", "Employees", new { area = "HR" }) ?? "#";
    var accountApiBaseUrl = Url.Content("~/api/employeeaccount");
    var trainingExperienceApiBaseUrl = Url.Content("~/api/employeetrainingexperience");
    var taskFollowUpApiBaseUrl = Url.Content("~/api/taskfollowup");
    var taskFollowUpFeatureCode = "HR_EMPLOYEE";
    @* 员工档案文档功能编码（对应员工主资料的通用文档集合）。 *@
    var employeeDocumentFeatureCode = "HR_EMPLOYEE";
    @* 员工图片文档功能编码（对应员工“更多图片”上传的图片集合）。 *@
    var employeePhotoFeatureCode = "HR_EMPLOYEE_PHOTO";
    var employeePrimaryPhotoUrl = Url.Action("SetPrimaryPhoto", "Employees", new { area = "HR" }) ?? "#";
    @* 培训历程档案文档功能编码（对应单条培训历程记录的通用文档集合）。 *@
    var trainingExperienceDocumentFeatureCode = "HR_EMPLOYEE_TRAINING_EXPERIENCE";
    @* 任务跟进档案文档功能编码（对应单条任务跟进记录的通用文档集合）。 *@
    var taskFollowUpDocumentFeatureCode = "HR_TASK_FOLLOW_UP";
}

<div class="employee-detail-page">
    <form id="employeeDetailForm"
          asp-area="HR"
          asp-controller="Employees"
          asp-action="@formAction"
          data-create-url="@createUrl"
          data-location-options-url="@locationOptionsUrl"
          data-account-api-base-url="@accountApiBaseUrl"
          data-training-experience-api-base-url="@trainingExperienceApiBaseUrl"
          data-task-follow-up-api-base-url="@taskFollowUpApiBaseUrl"
          data-task-follow-up-feature-code="@taskFollowUpFeatureCode"
          data-employee-document-feature-code="@employeeDocumentFeatureCode"
          data-employee-photo-feature-code="@employeePhotoFeatureCode"
          data-employee-primary-photo-url="@employeePrimaryPhotoUrl"
          class="employee-detail-shell @(isReadOnly ? "is-readonly" : "")">
        <input type="hidden" name="popup" value="@isPopup.ToString().ToLowerInvariant()" />
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="employee-detail-toolbar">
            @if (isReadOnly)
            {
                <button type="button" class="employee-detail-toolbar__btn" data-employee-tool="new" data-target-url="@createUrl">@Localizer["Common_Create"]</button>
                <button type="button" class="employee-detail-toolbar__btn" id="btnEdit" data-mode-toggle="edit">@Localizer["Common_Edit"]</button>
                <button type="button" class="employee-detail-toolbar__btn" data-employee-tool="copy">@Localizer["Common_Copy"]</button>
                <button type="button" class="employee-detail-toolbar__btn" data-employee-tool="mail">@Localizer["Common_Email"]</button>
                <button type="button" class="employee-detail-toolbar__btn" data-employee-tool="message">@Localizer["Common_Info"]</button>
            }
            else
            {
                <button type="submit" class="employee-detail-toolbar__btn" id="btnSave">@saveButtonText</button>
            }
            <button type="button" class="employee-detail-toolbar__btn" onclick="window.closeEmployeeDetailPage()">@Localizer["Common_Close"]</button>
        </div>

        <div asp-validation-summary="ModelOnly" class="employee-detail-validation"></div>

        <section class="employee-detail-hero">
            <div class="employee-detail-hero__grid">
                <div class="employee-detail-field">
                    <label asp-for="EmployeeCode">@Localizer["Employee_Code"]</label>
                    <div class="employee-detail-field__inline">
                        <input asp-for="EmployeeCode" class="form-control" placeholder="请输入" readonly="@ro" />
                        <button type="button"
                                class="employee-detail-icon-btn"
                                data-employee-tool="lookup"
                                aria-label="@Localizer["Employee_LookupEmployeeCodeAria"]"
                                @(isReadOnly ? "style=display:none" : "")>
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                </div>

                <div class="employee-detail-field employee-detail-field--double">
                    <label>@Localizer["Employee_Name"]</label>
                    <div class="employee-detail-field__pair">
                        <input asp-for="LastName" class="form-control" placeholder="姓" readonly="@ro" />
                        <input asp-for="FirstName" class="form-control" placeholder="名" readonly="@ro" />
                    </div>
                    <div class="employee-detail-field__pair employee-detail-field__pair--messages">
                        <span asp-validation-for="LastName" class="text-danger"></span>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>

                <div class="employee-detail-field">
                    <label asp-for="HireDate">@Localizer["Employee_Label_HireDate"]</label>
                    <input asp-for="HireDate" type="date" class="form-control" readonly="@ro" />
                    <span asp-validation-for="HireDate" class="text-danger"></span>
                </div>

                <div class="employee-detail-field">
                    <label asp-for="LeaveDate">@Localizer["Employee_Label_LeaveDate"]</label>
                    <input asp-for="LeaveDate" type="date" class="form-control" data-employee-leave-date readonly="@ro" />
                    <span asp-validation-for="LeaveDate" class="text-danger"></span>
                </div>

                <div class="employee-detail-status @(isLeaveStatus ? "is-leave" : "is-active")" data-employee-status-card>
                    <span class="employee-detail-status__label">@Localizer["Employee_CurrentStatus"]</span>
                    <strong class="employee-detail-status__value" data-employee-status-text>@detailStatus</strong>
                </div>

                <div class="employee-detail-field">
                    <label asp-for="OrganizationId">@Localizer["Employee_Organization"]</label>
                    <select asp-for="OrganizationId" class="form-select" asp-items="ViewBag.OrganizationId" disabled="@dis">
                        <option value="">请选择</option>
                    </select>
                    <span asp-validation-for="OrganizationId" class="text-danger"></span>
                </div>

                <div class="employee-detail-field">
                    <label asp-for="DepartmentId">@Localizer["Common_Department"]</label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId" disabled="@dis">
                        <option value="">请选择</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <div class="employee-detail-field">
                    <label asp-for="GroupId">@Localizer["Employee_Group"]</label>
                    <select asp-for="GroupId" class="form-select" asp-items="ViewBag.GroupId" disabled="@dis">
                        <option value="">请选择</option>
                    </select>
                    <span asp-validation-for="GroupId" class="text-danger"></span>
                </div>

                <div class="employee-detail-field">
                    <label asp-for="PositionId">职务</label>
                    <div class="employee-detail-field__select-action">
                        <select asp-for="PositionId" class="form-select" asp-items="ViewBag.PositionId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <button type="button"
                                class="employee-detail-select-btn"
                                data-popup-url="@positionManagerUrl"
                                data-popup-title="职务选项维护"
                                data-custom-option-trigger
                                data-custom-option-source="position"
                                data-custom-option-target="PositionId"
                                data-custom-option-endpoint="@positionOptionsUrl"
                                @(isReadOnly ? "style=display:none" : "")>
                            <i class="bi bi-sliders"></i>
                        </button>
                    </div>
                    <span asp-validation-for="PositionId" class="text-danger"></span>
                </div>
            </div>
        </section>

        <nav class="employee-detail-tabs">
            <button type="button" class="employee-detail-tabs__item is-active" data-tab-panel="basicInfo">@Localizer["Employee_Tab_BasicInfo"]</button>
            <button type="button" class="employee-detail-tabs__item" data-tab-panel="accountPermission">@Localizer["Employee_Tab_AccountPermission"]</button>
            <button type="button" class="employee-detail-tabs__item" data-tab-panel="attendanceSalary">@Localizer["Employee_Tab_AttendanceSalary"]</button>
            <button type="button" class="employee-detail-tabs__item" data-tab-panel="trainingExperience">培训历程</button>
            <button type="button" class="employee-detail-tabs__item" data-tab-panel="taskFollowUp">任务跟进</button>
        </nav>

        <section class="employee-detail-body" data-tab-content="basicInfo">
            <div class="employee-detail-main">
                <div class="employee-detail-grid">
                    <div class="employee-detail-field">
                        <label asp-for="AliasName">别名</label>
                        <input asp-for="AliasName" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="AliasName" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="GenderId">性别</label>
                        <select asp-for="GenderId" class="form-select" asp-items="ViewBag.GenderId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <span asp-validation-for="GenderId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="BirthDate">出生日期</label>
                        <input asp-for="BirthDate" type="date" class="form-control" readonly="@ro" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="IdCardNumber">身份证号</label>
                        <input asp-for="IdCardNumber" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="IdCardNumber" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="EthnicityId">民族</label>
                        <div class="employee-detail-field__select-action">
                            <select asp-for="EthnicityId" class="form-select" asp-items="ViewBag.EthnicityId" disabled="@dis">
                                <option value="">请选择</option>
                            </select>
                            <button type="button"
                                    class="employee-detail-select-btn"
                                    data-popup-url="@ethnicityManagerUrl"
                                    data-popup-title="民族选项维护"
                                    data-custom-option-trigger
                                    data-custom-option-source="ethnicity"
                                    data-custom-option-target="EthnicityId"
                                    data-custom-option-endpoint="@ethnicityOptionsUrl"
                                    @(isReadOnly ? "style=display:none" : "")>
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                        <span asp-validation-for="EthnicityId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="MaritalStatusId">婚姻状况</label>
                        <select asp-for="MaritalStatusId" class="form-select" asp-items="ViewBag.MaritalStatusId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <span asp-validation-for="MaritalStatusId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="EducationLevelId">学历</label>
                        <select asp-for="EducationLevelId" class="form-select" asp-items="ViewBag.EducationLevelId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <span asp-validation-for="EducationLevelId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="EducationCertificateNumber">学历证书</label>
                        <input asp-for="EducationCertificateNumber" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="EducationCertificateNumber" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="ProfessionalTitleId">职称</label>
                        <div class="employee-detail-field__select-action">
                            <select asp-for="ProfessionalTitleId" class="form-select" asp-items="ViewBag.ProfessionalTitleId" disabled="@dis">
                                <option value="">请选择</option>
                            </select>
                            <button type="button"
                                    class="employee-detail-select-btn"
                                    data-popup-url="@professionalTitleManagerUrl"
                                    data-popup-title="职称选项维护"
                                    data-custom-option-trigger
                                    data-custom-option-source="professional-title"
                                    data-custom-option-target="ProfessionalTitleId"
                                    data-custom-option-endpoint="@professionalTitleOptionsUrl"
                                    @(isReadOnly ? "style=display:none" : "")>
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ProfessionalTitleId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="PhoneNumber">电话1</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="PhoneNumber2">电话2</label>
                        <input asp-for="PhoneNumber2" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="PhoneNumber2" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="PhoneNumber3">电话3</label>
                        <input asp-for="PhoneNumber3" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="PhoneNumber3" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="CountryRegionId">国家/地区</label>
                        <select asp-for="CountryRegionId" class="form-select" asp-items="ViewBag.CountryRegionId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <span asp-validation-for="CountryRegionId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="CityId">城市</label>
                        <select asp-for="CityId" class="form-select" asp-items="ViewBag.CityId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <span asp-validation-for="CityId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="CountyId">县/区</label>
                        <select asp-for="CountyId" class="form-select" asp-items="ViewBag.CountyId" disabled="@dis">
                            <option value="">请选择</option>
                        </select>
                        <span asp-validation-for="CountyId" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field employee-detail-field--full">
                        <label asp-for="JobTitle">岗位</label>
                        <input asp-for="JobTitle" class="form-control" placeholder="请输入岗位名称" readonly="@ro" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field employee-detail-field--full">
                        <label asp-for="Address">地址</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="请输入详细地址" readonly="@ro"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field employee-detail-field--full">
                        <label asp-for="Email">邮箱</label>
                        <input asp-for="Email" class="form-control" placeholder="请输入邮箱地址" readonly="@ro" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field employee-detail-field--full employee-detail-field--large">
                        <label asp-for="Remarks">备注</label>
                        <textarea asp-for="Remarks" class="form-control" rows="6" placeholder="请输入备注信息" readonly="@ro"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="EmergencyContact">紧急联系人</label>
                        <input asp-for="EmergencyContact" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="EmergencyContact" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="EmergencyContactPhone">紧急联系人电话</label>
                        <input asp-for="EmergencyContactPhone" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field">
                        <label asp-for="Referrer">介绍人</label>
                        <input asp-for="Referrer" class="form-control" placeholder="请输入" readonly="@ro" />
                        <span asp-validation-for="Referrer" class="text-danger"></span>
                    </div>

                    <div class="employee-detail-field employee-detail-field--full">
                        <label asp-for="ArchivePath">档案管理</label>
                        <input asp-for="ArchivePath" type="hidden" />
                        <button type="button"
                                class="employee-detail-document-btn"
                                data-employee-tool="archive">
                            <i class="bi bi-folder2-open" aria-hidden="true"></i>
                            <span>打开档案管理</span>
                        </button>
                        <span asp-validation-for="ArchivePath" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <aside class="employee-detail-side">
                <div class="employee-detail-photo">
                    <input type="hidden" asp-for="PhotoPath" />
                    <div class="employee-detail-photo__frame" data-employee-photo-frame>
                        @if (!string.IsNullOrWhiteSpace(Model?.PhotoPath))
                        {
                            <img src="@Model.PhotoPath" alt="员工照片" class="employee-detail-photo__image" />
                        }
                        else
                        {
                            <span class="employee-detail-photo__placeholder">显示员工相片</span>
                        }
                    </div>
                    <button type="button" class="employee-detail-side__btn" data-employee-tool="photo">更多图片</button>
                    <button type="button" class="employee-detail-side__btn" data-employee-tool="archive">档案管理</button>
                </div>
            </aside>
        </section>

        <section class="employee-detail-body" data-tab-content="accountPermission" style="display:none;">
            <div class="employee-detail-main">
                <div class="account-panel" id="accountPermissionPanel" data-employee-id="@(Model?.Id ?? 0)">
                    <div class="account-panel__loading">加载中...</div>
                </div>
            </div>
        </section>
        <section class="employee-detail-body" data-tab-content="attendanceSalary" style="display:none;">
            <div class="employee-detail-main">
                <div class="attendance-panel">
                    <section class="attendance-section">
                        <div class="attendance-grid attendance-grid--top">
                            <div class="attendance-field">
                                <label asp-for="EmploymentTypeId">受雇方式</label>
                                <select asp-for="EmploymentTypeId" class="form-select" asp-items="ViewBag.EmploymentTypeId" disabled="@dis">
                                    <option value="">请选择</option>
                                </select>
                                <span asp-validation-for="EmploymentTypeId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="AllowancePackageId">津贴待遇</label>
                                <div class="employee-detail-field__select-action">
                                    <select asp-for="AllowancePackageId" class="form-select" asp-items="ViewBag.AllowancePackageId" disabled="@dis">
                                        <option value="">请选择</option>
                                    </select>
                                    <button type="button"
                                            class="employee-detail-select-btn"
                                            data-popup-url="@allowancePackageManagerUrl"
                                            data-popup-title="津贴待遇选项维护"
                                            data-custom-option-trigger
                                            data-custom-option-source="allowance-package"
                                            data-custom-option-target="AllowancePackageId"
                                            data-custom-option-endpoint="@allowancePackageOptionsUrl"
                                            @(isReadOnly ? "style=display:none" : "")>
                                        <i class="bi bi-sliders"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="AllowancePackageId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="ProbationEndDate">试用期日期</label>
                                <input asp-for="ProbationEndDate" type="date" class="form-control" readonly="@ro" />
                                <span asp-validation-for="ProbationEndDate" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="CardNumber">员工卡号</label>
                                <input asp-for="CardNumber" class="form-control" placeholder="可留空" readonly="@ro" />
                                <span asp-validation-for="CardNumber" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="AnnualLeaveCalculationMethodId">年假计算方式</label>
                                <select asp-for="AnnualLeaveCalculationMethodId" class="form-select" asp-items="ViewBag.AnnualLeaveCalculationMethodId" disabled="@dis">
                                    <option value="">请选择</option>
                                </select>
                                <span asp-validation-for="AnnualLeaveCalculationMethodId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field attendance-field--checkbox">
                                <label>是否考勤</label>
                                <label class="attendance-checkbox">
                                    <input asp-for="IsAttendanceRequired" type="checkbox" disabled="@dis" />
                                    <span>纳入考勤</span>
                                </label>
                            </div>
                        </div>

                        <div class="attendance-metrics">
                            <div class="attendance-field">
                                <label asp-for="CurrentYearAnnualLeaveDays">本年享有年假日数</label>
                                <input asp-for="CurrentYearAnnualLeaveDays" type="number" step="any" class="form-control" readonly="@ro" />
                                <span asp-validation-for="CurrentYearAnnualLeaveDays" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="AnnualLeaveMaxAccumulatedDays">年假最多累积日数</label>
                                <input asp-for="AnnualLeaveMaxAccumulatedDays" type="number" step="any" class="form-control" readonly="@ro" />
                                <span asp-validation-for="AnnualLeaveMaxAccumulatedDays" class="text-danger"></span>
                            </div>

                            <div class="attendance-field attendance-field--inline-action">
                                <label asp-for="AnnualLeaveRemainingDays">剩余年假日数</label>
                                <div class="attendance-inline-group">
                                    <input asp-for="AnnualLeaveRemainingDays" type="number" step="any" class="form-control" readonly="@ro" />
                                    <button type="button" class="attendance-inline-btn" data-employee-tool="annualLeaveHistory">年假调整及历史</button>
                                </div>
                                <span asp-validation-for="AnnualLeaveRemainingDays" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="AnnualLeaveIncrementStartYears">入职满年数可递增年假</label>
                                <input asp-for="AnnualLeaveIncrementStartYears" type="number" step="1" min="0" class="form-control" readonly="@ro" />
                                <span asp-validation-for="AnnualLeaveIncrementStartYears" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="AnnualLeaveIncrementPerYearDays">每年递增年假日数</label>
                                <input asp-for="AnnualLeaveIncrementPerYearDays" type="number" step="any" class="form-control" readonly="@ro" />
                                <span asp-validation-for="AnnualLeaveIncrementPerYearDays" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="AnnualLeaveCapDays">年假封顶日数</label>
                                <input asp-for="AnnualLeaveCapDays" type="number" step="any" class="form-control" readonly="@ro" />
                                <span asp-validation-for="AnnualLeaveCapDays" class="text-danger"></span>
                            </div>
                        </div>
                    </section>

                    <section class="attendance-section">
                        <div class="attendance-grid">
                            <div class="attendance-field">
                                <label asp-for="DefaultShiftId">默认上班班次</label>
                                <select asp-for="DefaultShiftId" class="form-select" asp-items="ViewBag.DefaultShiftId" disabled="@dis">
                                    <option value="">请选择</option>
                                </select>
                                <span asp-validation-for="DefaultShiftId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="SchedulingGroupId">排班组别</label>
                                <div class="employee-detail-field__select-action">
                                    <select asp-for="SchedulingGroupId" class="form-select" asp-items="ViewBag.SchedulingGroupId" disabled="@dis">
                                        <option value="">请选择</option>
                                    </select>
                                    <button type="button"
                                            class="employee-detail-select-btn"
                                            data-popup-url="@schedulingGroupManagerUrl"
                                            data-popup-title="排班组别选项维护"
                                            data-custom-option-trigger
                                            data-custom-option-source="scheduling-group"
                                            data-custom-option-target="SchedulingGroupId"
                                            data-custom-option-endpoint="@schedulingGroupOptionsUrl"
                                            @(isReadOnly ? "style=display:none" : "")>
                                        <i class="bi bi-sliders"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="SchedulingGroupId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field attendance-field--checkbox">
                                <label>自动排班</label>
                                <label class="attendance-checkbox">
                                    <input asp-for="IsAutoSchedulingEnabled" type="checkbox" disabled="@dis" />
                                    <span>启用自动排班</span>
                                </label>
                            </div>
                        </div>
                    </section>

                    <section class="attendance-section">
                        <div class="attendance-grid">
                            <div class="attendance-field">
                                <label asp-for="SalaryGradeId">工资级别</label>
                                <select asp-for="SalaryGradeId" class="form-select" asp-items="ViewBag.SalaryGradeId" disabled="@dis">
                                    <option value="">请选择</option>
                                </select>
                                <span asp-validation-for="SalaryGradeId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="PayrollCompanyId">支薪公司</label>
                                <select asp-for="PayrollCompanyId" class="form-select" asp-items="ViewBag.PayrollCompanyId" disabled="@dis">
                                    <option value="">请选择</option>
                                </select>
                                <span asp-validation-for="PayrollCompanyId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="BankId">所属银行</label>
                                <div class="employee-detail-field__select-action">
                                    <select asp-for="BankId" class="form-select" asp-items="ViewBag.BankId" disabled="@dis">
                                        <option value="">请选择</option>
                                    </select>
                                    <button type="button"
                                            class="employee-detail-select-btn"
                                            data-popup-url="@bankManagerUrl"
                                            data-popup-title="银行选项维护"
                                            data-custom-option-trigger
                                            data-custom-option-source="bank"
                                            data-custom-option-target="BankId"
                                            data-custom-option-endpoint="@bankOptionsUrl"
                                            @(isReadOnly ? "style=display:none" : "")>
                                        <i class="bi bi-sliders"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="BankId" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="BankAccountNumber">银行账号</label>
                                <input asp-for="BankAccountNumber" class="form-control" placeholder="请输入" readonly="@ro" />
                                <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                            </div>

                            <div class="attendance-field">
                                <label asp-for="BankAccountName">账户名称</label>
                                <input asp-for="BankAccountName" class="form-control" placeholder="请输入" readonly="@ro" />
                                <span asp-validation-for="BankAccountName" class="text-danger"></span>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <aside class="employee-detail-side">
                <div class="attendance-notes">
                    <section class="attendance-note-card">
                        <h3 class="attendance-note-card__title">年假规则说明</h3>
                        <p class="attendance-note-card__text">1. 年假计算方式会随员工资料一起保存，后续可继续接入更细的规则引擎。</p>
                        <p class="attendance-note-card__text">2. 剩余年假与封顶日数建议按实际制度维护，方便后续扩展调整历史。</p>
                    </section>

                    <section class="attendance-note-card">
                        <h3 class="attendance-note-card__title">考勤说明</h3>
                        <p class="attendance-note-card__text">1. 默认上班班次与排班组别用于后续考勤、排班及迟到早退统计。</p>
                        <p class="attendance-note-card__text">2. 未启用考勤时，该员工不会纳入排班与考勤统计。</p>
                    </section>
                </div>
            </aside>
        </section>

        <section class="employee-detail-body employee-detail-body--single" data-tab-content="trainingExperience" style="display:none;">
            <div class="employee-detail-main">
                <div class="training-experience-panel"
                     id="trainingExperiencePanel"
                     data-employee-id="@(Model?.Id ?? 0)"
                     data-document-feature-code="@trainingExperienceDocumentFeatureCode">
                    <div class="training-experience-toolbar">
                        <div class="training-experience-toolbar__filters">
                            <select id="trainingExperienceTypeFilter" class="form-select">
                                <option value="">全部</option>
                            </select>
                            <input id="trainingExperienceKeyword" type="text" class="form-control" placeholder="请输入关键字查询" />
                            <button type="button" class="employee-detail-toolbar__btn" id="trainingExperienceSearchButton">查询</button>
                            <button type="button" class="employee-detail-toolbar__btn" id="trainingExperienceRefreshButton">刷新</button>
                        </div>

                        <div class="training-experience-toolbar__actions">
                            <button type="button" class="employee-detail-toolbar__btn" id="trainingExperienceAddButton">新增</button>
                            <button type="button" class="employee-detail-toolbar__btn" id="trainingExperienceDeleteButton">删除</button>
                        </div>
                    </div>

                    <section class="training-experience-editor" id="trainingExperienceEditor" hidden>
                        <div class="training-experience-editor__header">
                            <h3 class="training-experience-editor__title">培训历程编辑</h3>
                            <div class="training-experience-editor__actions">
                                <button type="button" class="employee-detail-toolbar__btn" id="trainingExperienceSaveButton">保存历程</button>
                                <button type="button" class="employee-detail-toolbar__btn" id="trainingExperienceCancelButton">取消</button>
                            </div>
                        </div>

                        <input type="hidden" id="trainingExperienceId" />
                        <div class="training-experience-editor__grid">
                            <div class="training-experience-field">
                                <label for="trainingExperienceStartDate">开始日期</label>
                                <input id="trainingExperienceStartDate" type="date" class="form-control" />
                            </div>

                            <div class="training-experience-field">
                                <label for="trainingExperienceEndDate">结束日期</label>
                                <input id="trainingExperienceEndDate" type="date" class="form-control" />
                            </div>

                            <div class="training-experience-field">
                                <label for="trainingExperienceTypeCode">历程类型</label>
                                <select id="trainingExperienceTypeCode" class="form-select"></select>
                            </div>

                            <div class="training-experience-field">
                                <label for="trainingExperienceOrganizationName">培训/工作机构</label>
                                <input id="trainingExperienceOrganizationName" type="text" class="form-control" placeholder="请输入机构或单位名称" />
                            </div>

                            <div class="training-experience-field">
                                <label for="trainingExperienceCertificateName">荣誉证书/培训证</label>
                                <input id="trainingExperienceCertificateName" type="text" class="form-control" placeholder="请输入证书名称或编号" />
                            </div>

                            <div class="training-experience-field">
                                <label for="trainingExperienceArchiveButton">档案管理</label>
                                <button id="trainingExperienceArchiveButton"
                                        type="button"
                                        class="training-experience-document-btn"
                                        data-action="manageTrainingExperienceArchive"
                                        disabled>
                                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                    <span>打开档案管理</span>
                                </button>
                            </div>

                            <div class="training-experience-field training-experience-field--full">
                                <label for="trainingExperienceDescription">历程描述</label>
                                <textarea id="trainingExperienceDescription" class="form-control" rows="4" placeholder="请输入工作内容、培训主题或教育经历说明"></textarea>
                            </div>
                        </div>
                    </section>

                    <div class="training-experience-table-shell">
                        <table class="training-experience-table" id="trainingExperienceTable">
                            <thead>
                                <tr>
                                    <th class="training-experience-table__seq">序号</th>
                                    <th class="training-experience-table__checkbox">
                                        <input id="trainingExperienceSelectAll" type="checkbox" aria-label="全选培训历程记录" />
                                    </th>
                                    <th>类型</th>
                                    <th>开始日期</th>
                                    <th>结束日期</th>
                                    <th>历程描述</th>
                                    <th>荣誉证书/培训证</th>
                                    <th>培训/工作机构</th>
                                    <th>档案</th>
                                    <th>创建人</th>
                                    <th>创建日期</th>
                                </tr>
                            </thead>
                            <tbody id="trainingExperienceTableBody">
                                <tr>
                                    <td colspan="11" class="training-experience-table__empty">加载中...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="training-experience-footer">
                        <div class="training-experience-footer__summary" id="trainingExperienceSummary">共 0 条</div>
                        <div class="training-experience-footer__pager">
                            <button type="button" class="training-experience-pagebtn" id="trainingExperiencePrevPage">&lsaquo;</button>
                            <div class="training-experience-pagenums" id="trainingExperiencePageNumbers"></div>
                            <button type="button" class="training-experience-pagebtn" id="trainingExperienceNextPage">&rsaquo;</button>
                            <select id="trainingExperiencePageSize" class="form-select training-experience-pagesize">
                                <option value="10" selected>10条/页</option>
                                <option value="20">20条/页</option>
                                <option value="50">50条/页</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="employee-detail-body employee-detail-body--single" data-tab-content="taskFollowUp" style="display:none;">
            <div class="employee-detail-main">
                <div class="task-follow-up-panel"
                     id="taskFollowUpPanel"
                     data-entity-id="@(Model?.Id ?? 0)"
                     data-feature-code="@taskFollowUpFeatureCode"
