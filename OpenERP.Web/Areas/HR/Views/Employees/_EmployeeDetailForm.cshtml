                            <div class="task-follow-up-field">
                                <label for="taskFollowUpArchiveButton">档案管理</label>
                                <button id="taskFollowUpArchiveButton"
                                        type="button"
                                        class="task-follow-up-document-btn"
                                        data-action="manageTaskFollowUpArchive"
                                        disabled>
                                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                    <span>打开档案管理</span>
                                </button>
                            </div>
                        </div>
                    </section>

                    <div class="task-follow-up-table-shell">
                        <table class="task-follow-up-table" id="taskFollowUpTable">
                            <thead>
                                <tr>
                                    <th class="task-follow-up-table__seq">序号</th>
                                    <th class="task-follow-up-table__checkbox">
                                        <input id="taskFollowUpSelectAll" type="checkbox" aria-label="全选任务跟进记录" />
                                    </th>
                                    <th>任务编号</th>
                                    <th>档案</th>
                                    <th>状态</th>
                                    <th>计划日期</th>
                                    <th>类型</th>
                                    <th>执行人</th>
                                    <th>任务描述</th>
                                    <th>优先级别</th>
                                    <th>执行进程(%)</th>
                                    <th>完成日期</th>
                                    <th>项目编号</th>
                                    <th>发起人</th>
                                    <th>创建日期</th>
                                </tr>
                            </thead>
                            <tbody id="taskFollowUpTableBody">
                                <tr>
                                    <td colspan="15" class="task-follow-up-table__empty">加载中...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="task-follow-up-footer">
                        <div class="task-follow-up-footer__summary" id="taskFollowUpSummary">共 0 条</div>
                        <div class="task-follow-up-footer__pager">
                            <button type="button" class="task-follow-up-pagebtn" id="taskFollowUpPrevPage">&lsaquo;</button>
                            <div class="task-follow-up-pagenums" id="taskFollowUpPageNumbers"></div>
                            <button type="button" class="task-follow-up-pagebtn" id="taskFollowUpNextPage">&rsaquo;</button>
                            <select id="taskFollowUpPageSize" class="form-select task-follow-up-pagesize">
