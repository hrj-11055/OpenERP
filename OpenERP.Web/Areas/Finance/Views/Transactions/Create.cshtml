@model OpenERP.Finance.Models.Entities.Transaction
@{
    ViewData["Title"] = "新建凭证";
}
<div class="container">
    <h2 class="mt-4">新建凭证</h2>
    <form asp-area="Finance" asp-controller="Transactions" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="DocNumber" class="form-label"></label>
            <input asp-for="DocNumber" class="form-control" />
            <span asp-validation-for="DocNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DocDate" class="form-label"></label>
            <input asp-for="DocDate" class="form-control" type="date" />
        </div>
        <div class="mb-3">
            <label asp-for="AccountId" class="form-label">科目</label>
            <select asp-for="AccountId" asp-items="ViewBag.AccountId" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-area="Finance" asp-controller="Transactions" asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
