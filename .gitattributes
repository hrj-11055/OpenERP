# 统一换行符处理：文本文件入库时规范化为 LF，检出时按平台处理
* text=auto

# Windows 批处理/PowerShell 保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件（不做换行符转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.docx binary
*.xlsx binary
*.dll binary
*.exe binary
